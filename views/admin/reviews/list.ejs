<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reviews - New Heels Admin</title>
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
<link rel="apple-touch-icon" href="/images/logo.jpg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="/css/admin.css" rel="stylesheet">
</head>
<body>
    <%- include('../partials/sidebar', { activePage: 'reviews' }) %>

    <div class="main-content">
        <div class="top-navbar">
            <div class="d-flex align-items-center gap-3">
                <div style="width: 45px; height: 45px; background: #F8F3EF; display: flex; align-items: center; justify-content: center; border-left: 3px solid #C9A45C;">
                    <i class="bi bi-chat-quote" style="font-size: 22px; color: #8B6688;"></i>
                </div>
                <div>
                    <h5 class="m-0">Customer Reviews</h5>
                    <small style="color: #8B6688; font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase;">Manage product reviews</small>
                </div>
            </div>
            <div class="admin-info">
                <div class="admin-avatar"><%= adminUsername.charAt(0).toUpperCase() %></div>
                <div>
                    <div class="admin-name"><%= adminUsername %></div>
                    <div class="admin-role">Administrator</div>
                </div>
            </div>
        </div>

        <% if (success) { %>
            <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i><%= success %></div>
        <% } %>

        <!-- Filter Tabs -->
        <div class="filter-tabs">
            <a href="/admin/reviews?status=all" class="filter-tab <%= currentStatus === 'all' ? 'active' : '' %>">
                All <span class="count"><%= counts.all %></span>
            </a>
            <a href="/admin/reviews?status=approved" class="filter-tab <%= currentStatus === 'approved' ? 'active' : '' %>">
                Approved <span class="count"><%= counts.approved %></span>
            </a>
            <a href="/admin/reviews?status=pending" class="filter-tab <%= currentStatus === 'pending' ? 'active' : '' %>">
                Hidden <span class="count"><%= counts.pending %></span>
            </a>
        </div>

        <!-- Reviews List -->
        <% if (reviews.length > 0) { %>
            <% reviews.forEach(function(review) { %>
                <div class="detail-card" style="margin-bottom: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: start; flex-wrap: wrap; gap: 15px;">
                        
                        <!-- Left: Review content -->
                        <div style="flex: 1; min-width: 300px;">
                            
                            <!-- Product Info -->
                            <% if (review.product) { %>
                                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 15px; padding-bottom: 15px; border-bottom: 1px solid #F8F3EF;">
                                    <% if (review.product.images && review.product.images.length > 0) { %>
                                        <img src="<%= review.product.images[0] %>" style="width: 50px; height: 50px; object-fit: cover; border: 1px solid #F8F3EF;">
                                    <% } %>
                                    <div>
                                        <div style="color: #8B6688; font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase;">Product</div>
                                        <a href="/product/<%= review.product.slug %>" target="_blank" style="color: #3F3040; font-weight: 500; font-size: 13px; text-decoration: none;">
                                            <%= review.product.name %>
                                        </a>
                                    </div>
                                </div>
                            <% } %>
                            
                            <!-- Review Header -->
                            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                                <div style="width: 40px; height: 40px; background: #8B6688; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; font-size: 15px;">
                                    <%= review.name.charAt(0).toUpperCase() %>
                                </div>
                                <div>
                                    <div style="color: #3F3040; font-weight: 600; font-size: 14px;"><%= review.name %></div>
                                    <div style="color: #8B6688; font-size: 11px;"><%= review.email %></div>
                                </div>
                                <div style="margin-left: auto; display: flex; align-items: center; gap: 4px;">
                                    <% for (var i = 1; i <= 5; i++) { %>
                                        <i class="bi bi-star<%= i <= review.rating ? '-fill' : '' %>" style="color: #C9A45C; font-size: 12px;"></i>
                                    <% } %>
                                </div>
                            </div>
                            
                            <!-- Review Comment -->
                            <div style="color: #5a4a5c; font-size: 13px; line-height: 1.7; padding: 12px 15px; background: #F8F3EF; border-left: 3px solid #C9A45C; margin-bottom: 12px;">
                                <%= review.comment %>
                            </div>
                            
                            <!-- Meta -->
                            <div style="display: flex; gap: 20px; font-size: 11px; color: #8B6688; letter-spacing: 0.5px;">
                                <span><i class="bi bi-calendar me-1"></i><%= review.createdAt.toLocaleDateString('en-PK') %></span>
                                <span>
                                    <% if (review.isApproved) { %>
                                        <span style="color: #388E3C;"><i class="bi bi-check-circle me-1"></i>Approved</span>
                                    <% } else { %>
                                        <span style="color: #C2185B;"><i class="bi bi-eye-slash me-1"></i>Hidden</span>
                                    <% } %>
                                </span>
                            </div>
                        </div>
                        
                        <!-- Right: Actions -->
                        <div style="display: flex; flex-direction: column; gap: 8px; min-width: 140px;">
                            <% if (!review.isApproved) { %>
                                <form action="/admin/reviews/approve/<%= review._id %>" method="POST" style="margin: 0;">
                                    <button type="submit" class="btn-view" style="background: #E8F5E9; color: #388E3C; padding: 10px 15px; width: 100%; justify-content: center; letter-spacing: 1.5px; font-size: 11px; text-transform: uppercase;">
                                        <i class="bi bi-check-circle"></i> Approve
                                    </button>
                                </form>
                            <% } else { %>
                                <form action="/admin/reviews/unapprove/<%= review._id %>" method="POST" style="margin: 0;">
                                    <button type="submit" class="btn-view" style="background: #FFF3E0; color: #F57C00; padding: 10px 15px; width: 100%; justify-content: center; letter-spacing: 1.5px; font-size: 11px; text-transform: uppercase;">
                                        <i class="bi bi-eye-slash"></i> Hide
                                    </button>
                                </form>
                            <% } %>
                            
                            <form action="/admin/reviews/delete/<%= review._id %>" method="POST" style="margin: 0;" onsubmit="return confirm('Delete this review permanently?');">
                                <button type="submit" class="btn-view" style="background: #FCE4EC; color: #C2185B; padding: 10px 15px; width: 100%; justify-content: center; letter-spacing: 1.5px; font-size: 11px; text-transform: uppercase;">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </div>
                        
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="empty-state">
                <i class="bi bi-chat-quote"></i>
                <h4>No Reviews Yet</h4>
                <p>Customer reviews will appear here once submitted.</p>
            </div>
        <% } %>
    </div>
</body>
</html>