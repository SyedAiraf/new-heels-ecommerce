<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Banner - New Heels Admin</title>
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
<link rel="apple-touch-icon" href="/images/logo.jpg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="/css/admin.css" rel="stylesheet">
</head>
<body>
    <%- include('../partials/sidebar', { activePage: 'banners' }) %>

    <div class="main-content">
        <div class="top-navbar">
    <div class="d-flex align-items-center gap-3">
        <div style="width: 45px; height: 45px; background: #F8F3EF; display: flex; align-items: center; justify-content: center; border-left: 3px solid #C9A45C;">
            <i class="bi bi-image" style="font-size: 22px; color: #8B6688;"></i>
        </div>
        <div>
            <h5 class="m-0">Add New Banner</h5>
            <small style="color: #8B6688; font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase;">Create a hero slider banner</small>
        </div>
    </div>
    <div class="admin-info">
        <div class="admin-avatar"><%= adminUsername.charAt(0).toUpperCase() %></div>
        <div>
            <div class="admin-name"><%= adminUsername %></div>
            <div class="admin-role">Administrator</div>
        </div>
    </div>
</div>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <div class="form-card">
            <h6><i class="bi bi-image me-2"></i>Banner Information</h6>

            <form action="/admin/banners/add" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label">Banner Image * (Recommended: 1600x600 px)</label>
                    <input type="file" class="form-control" name="image" accept="image/*" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Title *</label>
                    <input type="text" class="form-control" name="title" placeholder="e.g., Step Into Style" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Subtitle</label>
                    <input type="text" class="form-control" name="subtitle" placeholder="e.g., Discover our exclusive collection">
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Button Text</label>
                        <input type="text" class="form-control" name="buttonText" value="Shop Now">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Button Link</label>
                        <input type="text" class="form-control" name="buttonLink" value="/category/female">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Order (lower = shows first)</label>
                    <input type="number" class="form-control" name="order" value="0">
                </div>

                <div class="mt-4">
                    <a href="/admin/banners" class="btn-cancel"><i class="bi bi-x-circle me-2"></i>Cancel</a>
                    <button type="submit" class="btn-submit"><i class="bi bi-check-circle me-2"></i>Add Banner</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>