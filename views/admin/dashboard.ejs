<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - New Heels Admin</title>
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
<link rel="apple-touch-icon" href="/images/logo.jpg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="/css/admin.css" rel="stylesheet">
</head>
<body>
    <%- include('partials/sidebar', { activePage: 'dashboard' }) %>

    <div class="main-content">
        <!-- Top Navbar with Logo -->
        <div class="top-navbar">
            <div class="d-flex align-items-center gap-3">
                <img src="/images/logo.jpg" alt="New Heels" style="height: 50px; width: auto;">
                <div>
                    <h5 class="m-0">Dashboard Overview</h5>
                    <small style="color: #8B6688; font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase;">Welcome back</small>
                </div>
            </div>
            <div class="admin-info">
                <div class="admin-avatar"><%= adminUsername.charAt(0).toUpperCase() %></div>
                <div>
                    <div class="admin-name"><%= adminUsername %></div>
                    <div class="admin-role">Administrator</div>
                </div>
            </div>
        </div>

        <% if (success) { %>
            <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i><%= success %></div>
        <% } %>
        <% if (error) { %>
            <div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i><%= error %></div>
        <% } %>

        <!-- Stats -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-box-seam"></i></div>
                <h3><%= stats.totalProducts %></h3>
                <p>Total Products</p>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-check-circle"></i></div>
                <h3><%= stats.activeProducts %></h3>
                <p>Active Products</p>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-cart3"></i></div>
                <h3><%= stats.totalOrders %></h3>
                <p>Total Orders</p>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-clock-history"></i></div>
                <h3><%= stats.pendingOrders %></h3>
                <p>Pending Orders</p>
            </div>
        </div>

        <!-- Revenue Card -->
        <div class="stats-row" style="grid-template-columns: repeat(2, 1fr);">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
                <h3>Rs. <%= stats.totalRevenue.toLocaleString() %></h3>
                <p>Total Revenue</p>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-star"></i></div>
                <h3><%= stats.newArrivals %></h3>
                <p>New Arrivals</p>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="form-card">
            <h6><i class="bi bi-lightning-charge me-2"></i>Quick Actions</h6>
            <div class="row">
                <div class="col-md-3 col-6 mb-3">
                    <a href="/admin/products/add" style="display: block; padding: 20px; background: #F8F3EF; text-decoration: none; text-align: center; transition: all 0.3s; border: 1px solid #E8DFD5;">
                        <i class="bi bi-plus-circle" style="font-size: 28px; color: #8B6688; display: block; margin-bottom: 10px;"></i>
                        <span style="color: #3F3040; font-size: 12px; letter-spacing: 1px; text-transform: uppercase;">Add Product</span>
                    </a>
                </div>
                <div class="col-md-3 col-6 mb-3">
                    <a href="/admin/orders" style="display: block; padding: 20px; background: #F8F3EF; text-decoration: none; text-align: center; transition: all 0.3s; border: 1px solid #E8DFD5;">
                        <i class="bi bi-cart3" style="font-size: 28px; color: #8B6688; display: block; margin-bottom: 10px;"></i>
                        <span style="color: #3F3040; font-size: 12px; letter-spacing: 1px; text-transform: uppercase;">View Orders</span>
                    </a>
                </div>
                <div class="col-md-3 col-6 mb-3">
                    <a href="/admin/banners" style="display: block; padding: 20px; background: #F8F3EF; text-decoration: none; text-align: center; transition: all 0.3s; border: 1px solid #E8DFD5;">
                        <i class="bi bi-images" style="font-size: 28px; color: #8B6688; display: block; margin-bottom: 10px;"></i>
                        <span style="color: #3F3040; font-size: 12px; letter-spacing: 1px; text-transform: uppercase;">Banners</span>
                    </a>
                </div>
                <div class="col-md-3 col-6 mb-3">
                    <a href="/admin/settings" style="display: block; padding: 20px; background: #F8F3EF; text-decoration: none; text-align: center; transition: all 0.3s; border: 1px solid #E8DFD5;">
                        <i class="bi bi-gear" style="font-size: 28px; color: #8B6688; display: block; margin-bottom: 10px;"></i>
                        <span style="color: #3F3040; font-size: 12px; letter-spacing: 1px; text-transform: uppercase;">Settings</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Recent Orders -->
        <div class="table-card">
            <h6><i class="bi bi-clock-history me-2"></i>Recent Orders</h6>
            <% if (recentOrders && recentOrders.length > 0) { %>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Customer</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentOrders.forEach(function(order) { %>
                                <tr>
                                    <td><strong style="color: #8B6688;"><%= order.orderNumber %></strong></td>
                                    <td><%= order.customer.name %></td>
                                    <td><strong>Rs. <%= order.total.toLocaleString() %></strong></td>
                                    <td><span class="badge-status status-<%= order.status %>"><%= order.status %></span></td>
                                    <td><a href="/admin/orders/<%= order._id %>" class="btn-view"><i class="bi bi-eye"></i> View</a></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="bi bi-cart-x"></i>
                    <h4>No Orders Yet</h4>
                    <p>When customers place orders, they'll appear here.</p>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>