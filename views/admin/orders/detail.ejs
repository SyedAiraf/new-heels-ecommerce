<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details - New Heels Admin</title>
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
<link rel="apple-touch-icon" href="/images/logo.jpg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="/css/admin.css" rel="stylesheet">
</head>
<body>
    <%- include('../partials/sidebar', { activePage: 'orders' }) %>

    <div class="main-content">
    <div class="top-navbar">
    <div class="d-flex align-items-center gap-3">
        <a href="/admin/orders" class="btn-view">
            <i class="bi bi-arrow-left"></i> Back
        </a>
        <div style="width: 45px; height: 45px; background: #F8F3EF; display: flex; align-items: center; justify-content: center; border-left: 3px solid #C9A45C;">
            <i class="bi bi-receipt" style="font-size: 22px; color: #8B6688;"></i>
        </div>
        <div>
            <h5 class="m-0">Order <%= order.orderNumber %></h5>
            <small style="color: #8B6688; font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase;">Order details & status</small>
        </div>
    </div>
    <span class="badge-status status-<%= order.status %>"><%= order.status %></span>
</div>

        <% if (success) { %>
            <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i><%= success %></div>
        <% } %>

        <div class="row">
            <div class="col-md-7">
                <div class="detail-card">
                    <h5><i class="bi bi-box-seam"></i> Order Items</h5>
                    <% order.items.forEach(function(item) { %>
                        <div class="order-item">
                            <img src="<%= item.productImage || 'https://via.placeholder.com/70/ffe0ef/ff1493?text=P' %>" alt="<%= item.productName %>">
                            <div class="order-item-info">
                                <div class="order-item-name"><%= item.productName %></div>
                                <div class="order-item-meta">
                                    <% if (item.size) { %>Size: <%= item.size %> | <% } %>
                                    <% if (item.color) { %>Color: <%= item.color %> | <% } %>
                                    Qty: <%= item.quantity %>
                                </div>
                            </div>
                            <div class="order-item-price">Rs. <%= (item.price * item.quantity).toLocaleString() %></div>
                        </div>
                    <% }); %>
                </div>

                <div class="detail-card">
                    <h5><i class="bi bi-person"></i> Customer Information</h5>
                    <div class="info-row"><span class="info-label">Full Name</span><span class="info-value"><%= order.customer.name %></span></div>
                    <div class="info-row"><span class="info-label">Phone</span><span class="info-value"><%= order.customer.phone %></span></div>
                    <div class="info-row"><span class="info-label">Email</span><span class="info-value"><%= order.customer.email %></span></div>
                    <div class="info-row"><span class="info-label">Address</span><span class="info-value"><%= order.customer.address %></span></div>
                    <div class="info-row"><span class="info-label">City</span><span class="info-value"><%= order.customer.city %></span></div>
                    <div class="info-row"><span class="info-label">Postal Code</span><span class="info-value"><%= order.customer.postalCode %></span></div>
                    <% if (order.customer.notes) { %>
                        <div class="info-row"><span class="info-label">Notes</span><span class="info-value"><%= order.customer.notes %></span></div>
                    <% } %>
                </div>
            </div>

            <div class="col-md-5">
                <div class="detail-card">
                    <h5><i class="bi bi-gear"></i> Update Status</h5>

                    <form action="/admin/orders/<%= order._id %>/status" method="POST" class="mb-3">
                        <label class="form-label">Order Status</label>
                        <select name="status" class="form-select mb-3">
                            <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
                            <option value="confirmed" <%= order.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                            <option value="processing" <%= order.status === 'processing' ? 'selected' : '' %>>Processing</option>
                            <option value="shipped" <%= order.status === 'shipped' ? 'selected' : '' %>>Shipped</option>
                            <option value="delivered" <%= order.status === 'delivered' ? 'selected' : '' %>>Delivered</option>
                            <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                        </select>
                        <button type="submit" class="btn-update w-100"><i class="bi bi-check-circle me-2"></i>Update Status</button>
                    </form>

                    <hr style="border-color: #ffe0ef;">

                    <form action="/admin/orders/<%= order._id %>/payment" method="POST">
                        <label class="form-label">Payment Status</label>
                        <select name="paymentStatus" class="form-select mb-3">
                            <option value="pending" <%= order.paymentStatus === 'pending' ? 'selected' : '' %>>Pending</option>
                            <option value="paid" <%= order.paymentStatus === 'paid' ? 'selected' : '' %>>Paid</option>
                        </select>
                        <button type="submit" class="btn-update w-100"><i class="bi bi-cash me-2"></i>Update Payment</button>
                    </form>
                </div>

                <div class="detail-card">
                    <h5><i class="bi bi-receipt"></i> Order Summary</h5>
                    <div class="summary-row"><span>Subtotal</span><span>Rs. <%= order.subtotal.toLocaleString() %></span></div>
                    <div class="summary-row">
                        <span>Delivery</span>
                        <span>
                            <% if (order.deliveryCharge === 0) { %>
                                <span style="color: #28a745;">FREE</span>
                            <% } else { %>
                                Rs. <%= order.deliveryCharge.toLocaleString() %>
                            <% } %>
                        </span>
                    </div>
                    <div class="summary-row total"><span>Total</span><span class="price">Rs. <%= order.total.toLocaleString() %></span></div>

                    <div class="info-row" style="margin-top: 15px;">
                        <span class="info-label">Payment Method</span>
                        <span class="info-value"><%= order.paymentMethod === 'cod' ? 'Cash on Delivery' : 'Bank Transfer' %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Payment Status</span>
                        <span class="info-value">
                            <span class="badge" style="background: <%= order.paymentStatus === 'paid' ? '#e8f5e9' : '#fff3e0' %>; color: <%= order.paymentStatus === 'paid' ? '#388e3c' : '#f57c00' %>;">
                                <%= order.paymentStatus.toUpperCase() %>
                            </span>
                        </span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Order Date</span>
                        <span class="info-value"><%= order.createdAt.toLocaleString('en-PK') %></span>
                    </div>
                </div>

                <div class="detail-card">
                    <form action="/admin/orders/<%= order._id %>/delete" method="POST" onsubmit="return confirm('Delete this order permanently?');">
                        <button type="submit" class="btn-delete w-100"><i class="bi bi-trash me-2"></i>Delete Order</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>