<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | - New Heels</title>
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
<link rel="apple-touch-icon" href="/images/logo.jpg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <style>
        .page-header {
            background: #F8F3EF;
            padding: 60px 0;
            color: #3F3040;
            text-align: center;
            margin-bottom: 40px;
            border-bottom: 1px solid #E8DFD5;
        }
        .page-header h1 {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 12px;
            letter-spacing: 4px;
            text-transform: uppercase;
        }
        .page-header p {
            color: #8B6688;
            font-size: 14px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        
        /* Subcategory Tabs */
        .subcat-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
            margin-bottom: 40px;
        }
        .subcat-tab {
            padding: 10px 22px;
            background: white;
            border: 1px solid #E8DFD5;
            color: #3F3040;
            text-decoration: none;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 2px;
            text-transform: uppercase;
            transition: all 0.3s;
        }
        .subcat-tab:hover { border-color: #8B6688; color: #8B6688; }
        .subcat-tab.active { background: #8B6688; color: white; border-color: #8B6688; }
        
        /* Filters Sidebar */
        .filters-sidebar {
            background: white;
            padding: 25px;
            border: 1px solid #F8F3EF;
            position: sticky;
            top: 20px;
        }
        .filter-heading {
            color: #3F3040;
            font-weight: 600;
            font-size: 13px;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid #F8F3EF;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .filter-section {
            margin-bottom: 25px;
        }
        .filter-section h6 {
            color: #8B6688;
            font-weight: 600;
            font-size: 11px;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 12px;
        }
        .size-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }
        .size-option {
            padding: 8px;
            border: 1px solid #E8DFD5;
            text-align: center;
            cursor: pointer;
            font-size: 12px;
            color: #3F3040;
            transition: all 0.3s;
            text-decoration: none;
            display: block;
        }
        .size-option:hover { border-color: #8B6688; color: #8B6688; }
        .size-option.active { background: #8B6688; color: white; border-color: #8B6688; }
        
        .color-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        .color-option {
            padding: 6px 14px;
            border: 1px solid #E8DFD5;
            font-size: 11px;
            color: #3F3040;
            text-decoration: none;
            transition: all 0.3s;
        }
        .color-option:hover { border-color: #8B6688; color: #8B6688; }
        .color-option.active { background: #8B6688; color: white; border-color: #8B6688; }
        
        .price-inputs {
            display: flex;
            gap: 8px;
            align-items: center;
        }
        .price-inputs input {
            width: 100%;
            padding: 8px 10px;
            border: 1px solid #E8DFD5;
            font-size: 12px;
            color: #3F3040;
            background: #F8F3EF;
        }
        .price-inputs input:focus { outline: none; border-color: #8B6688; background: white; }
        
        .apply-btn {
            background: #8B6688;
            color: white;
            border: none;
            width: 100%;
            padding: 12px;
            font-size: 11px;
            letter-spacing: 2px;
            text-transform: uppercase;
            cursor: pointer;
            margin-top: 10px;
        }
        .apply-btn:hover { background: #3F3040; }
        
        .clear-filters {
            color: #8B6688;
            text-decoration: none;
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        .clear-filters:hover { color: #3F3040; text-decoration: underline; }
        
        /* Product Grid */
        .product-card {
            background: white;
            border: 1px solid #F8F3EF;
            overflow: hidden;
            transition: all 0.3s;
            text-decoration: none;
            display: block;
            height: 100%;
        }
        .product-card:hover {
            box-shadow: 0 15px 35px rgba(63, 48, 64, 0.1);
            transform: translateY(-3px);
        }
        .product-image-wrapper { position: relative; overflow: hidden; background: #F8F3EF; }
        .product-image { width: 100%; height: 280px; object-fit: cover; transition: all 0.5s; }
        .product-card:hover .product-image { transform: scale(1.05); }
        .product-badge {
            position: absolute; top: 12px; left: 12px;
            background: #8B6688; color: white;
            padding: 5px 12px; font-size: 10px; font-weight: 600;
            letter-spacing: 2px; text-transform: uppercase; z-index: 2;
        }
        .discount-badge {
            position: absolute; top: 12px; right: 12px;
            background: #C9A45C; color: white;
            padding: 5px 10px; font-size: 11px; font-weight: 700; z-index: 2;
        }
        .sold-out-overlay {
            position: absolute; top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(63, 48, 64, 0.75); display: flex;
            align-items: center; justify-content: center;
            color: white; font-weight: 600; font-size: 16px;
            letter-spacing: 4px; text-transform: uppercase; z-index: 1;
        }
        .product-info { padding: 18px 15px; text-align: center; }
        .product-name { color: #3F3040; font-weight: 500; font-size: 14px; margin-bottom: 8px; }
        .product-price { color: #8B6688; font-weight: 700; font-size: 16px; }
        .product-original-price { color: #B9A0C0; text-decoration: line-through; font-size: 13px; margin-left: 8px; }
        
        /* Sort Bar */
        .sort-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            padding: 15px 20px;
            background: white;
            border: 1px solid #F8F3EF;
        }
        .sort-bar p { margin: 0; color: #8B6688; font-size: 13px; }
        .sort-select {
            border: 1px solid #E8DFD5;
            padding: 8px 15px;
            font-size: 12px;
            background: #F8F3EF;
            color: #3F3040;
            cursor: pointer;
        }
        .sort-select:focus { outline: none; border-color: #8B6688; }
        
        /* Mobile filter toggle */
        .filter-toggle-mobile {
            display: none;
            background: #8B6688;
            color: white;
            padding: 12px;
            text-align: center;
            margin-bottom: 20px;
            cursor: pointer;
            font-size: 13px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }
        
        .empty-state { text-align: center; padding: 80px 20px; }
        .empty-state i { font-size: 70px; color: #C9A45C; margin-bottom: 25px; }
        .empty-state h3 { color: #3F3040; margin-bottom: 12px; letter-spacing: 2px; text-transform: uppercase; }
        .empty-state p { color: #8B6688; }
        
        @media (max-width: 768px) {
            .page-header h1 { font-size: 24px; letter-spacing: 2px; }
            .product-image { height: 200px; }
            .filters-sidebar { position: static; margin-bottom: 20px; }
            .filter-toggle-mobile { display: block; }
        }
    </style>
</head>
<body>
    <% if (session && session.adminId) { %>
        <a href="/admin/dashboard" style="position: fixed; bottom: 20px; left: 20px; background: #8B6688; color: white; padding: 12px 20px; text-decoration: none; font-weight: 500; z-index: 9999; display: flex; align-items: center; gap: 8px; font-size: 13px;">
            <i class="bi bi-speedometer2"></i> Back to Admin
        </a>
    <% } %>

    <!-- Header -->
    <div class="header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-4 col-md-3">
                    <a href="/" class="logo"><img src="/images/logo.jpg" alt="New Heels"></a>
                </div>
                <div class="col-md-6 d-none d-md-block">
                    <form class="search-bar mx-auto" action="/search" method="GET">
                        <input type="text" name="q" placeholder="Search for shoes, bags..." required>
                        <button type="submit"><i class="bi bi-search"></i></button>
                    </form>
                </div>
                <div class="col-8 col-md-3 text-end">
                    <div class="header-icons justify-content-end">
                        <a href="#" class="header-icon"><i class="bi bi-heart"></i></a>
                        <a href="/cart" class="header-icon">
                            <i class="bi bi-cart"></i>
                            <span class="badge"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Navigation -->
    <div class="category-nav">
        <div class="container">
            <div class="d-flex justify-content-center flex-wrap">
                <a href="/">HOME</a>
                <a href="/category/men">MEN</a>
                <a href="/category/kids">KIDS</a>
                <a href="/category/female">WOMEN</a>
                <a href="/category/female?sub=shoes-sandals">SALE</a>
                <a href="/category/female?sub=bags-purses">NEW ARRIVALS</a>
            </div>
        </div>
    </div>

    <!-- Page Header -->
    <div class="page-header">
        <div class="container">
            <h1><%= category.charAt(0).toUpperCase() + category.slice(1) %>'s Collection</h1>
            <p>Discover our exclusive range</p>
        </div>
    </div>

    <!-- Subcategory Tabs -->
    <div class="container">
        <div class="subcat-tabs">
            <a href="/category/<%= category %>" class="subcat-tab <%= currentSub === 'all' ? 'active' : '' %>">
                All (<%= subcategoryCounts.all || 0 %>)
            </a>
            
            <% if (category === 'men') { %>
                <a href="/category/men?sub=shoes" class="subcat-tab <%= currentSub === 'shoes' ? 'active' : '' %>">Shoes (<%= subcategoryCounts.shoes || 0 %>)</a>
                <a href="/category/men?sub=chappals" class="subcat-tab <%= currentSub === 'chappals' ? 'active' : '' %>">Chappals (<%= subcategoryCounts.chappals || 0 %>)</a>
                <a href="/category/men?sub=peshawri" class="subcat-tab <%= currentSub === 'peshawri' ? 'active' : '' %>">Peshawri (<%= subcategoryCounts.peshawri || 0 %>)</a>
            <% } %>
            
            <% if (category === 'kids') { %>
                <a href="/category/kids?sub=toddler" class="subcat-tab <%= currentSub === 'toddler' ? 'active' : '' %>">Toddler (<%= subcategoryCounts.toddler || 0 %>)</a>
                <a href="/category/kids?sub=little-kids" class="subcat-tab <%= currentSub === 'little-kids' ? 'active' : '' %>">Little Kids (<%= subcategoryCounts['little-kids'] || 0 %>)</a>
                <a href="/category/kids?sub=big-kids" class="subcat-tab <%= currentSub === 'big-kids' ? 'active' : '' %>">Big Kids (<%= subcategoryCounts['big-kids'] || 0 %>)</a>
            <% } %>
            
            <% if (category === 'female') { %>
                <a href="/category/female?sub=bags-purses" class="subcat-tab <%= currentSub === 'bags-purses' ? 'active' : '' %>">Bags & Purses (<%= subcategoryCounts['bags-purses'] || 0 %>)</a>
                <a href="/category/female?sub=shoes-sandals" class="subcat-tab <%= currentSub === 'shoes-sandals' ? 'active' : '' %>">Shoes & Sandals (<%= subcategoryCounts['shoes-sandals'] || 0 %>)</a>
            <% } %>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container mb-5">
        <div class="row">
            <!-- Filters Sidebar -->
            <div class="col-md-3 mb-4">
                <div class="filter-toggle-mobile" onclick="document.getElementById('filtersBox').style.display = document.getElementById('filtersBox').style.display === 'none' ? 'block' : 'none'">
                    <i class="bi bi-funnel"></i> Show Filters
                </div>
                <div class="filters-sidebar" id="filtersBox">
                    <div class="filter-heading">
                        Filters
                        <a href="/category/<%= category %><%= currentSub !== 'all' ? '?sub=' + currentSub : '' %>" class="clear-filters">Clear All</a>
                    </div>
                    
                    <form method="GET" action="/category/<%= category %>">
                        <% if (currentSub !== 'all') { %>
                            <input type="hidden" name="sub" value="<%= currentSub %>">
                        <% } %>
                        
                        <!-- Size Filter -->
                        <% if (availableSizes.length > 0) { %>
                        <div class="filter-section">
                            <h6>Size</h6>
                            <div class="size-grid">
                                <% availableSizes.forEach(function(s) { %>
                                    <label class="size-option <%= filters.size === s ? 'active' : '' %>" style="cursor: pointer;">
                                        <input type="radio" name="size" value="<%= s %>" <%= filters.size === s ? 'checked' : '' %> style="display: none;" onchange="this.form.submit()">
                                        <%= s %>
                                    </label>
                                <% }); %>
                            </div>
                        </div>
                        <% } %>
                        
                        <!-- Color Filter -->
                        <% if (availableColors.length > 0) { %>
                        <div class="filter-section">
                            <h6>Color</h6>
                            <div class="color-grid">
                                <% availableColors.forEach(function(c) { %>
                                    <label class="color-option <%= filters.color === c ? 'active' : '' %>" style="cursor: pointer;">
                                        <input type="radio" name="color" value="<%= c %>" <%= filters.color === c ? 'checked' : '' %> style="display: none;" onchange="this.form.submit()">
                                        <%= c %>
                                    </label>
                                <% }); %>
                            </div>
                        </div>
                        <% } %>
                        
                        <!-- Price Range -->
                        <div class="filter-section">
                            <h6>Price (Rs.)</h6>
                            <div class="price-inputs">
                                <input type="number" name="minPrice" placeholder="Min" value="<%= filters.minPrice || '' %>">
                                <span style="color: #B9A0C0;">-</span>
                                <input type="number" name="maxPrice" placeholder="Max" value="<%= filters.maxPrice || '' %>">
                            </div>
                        </div>
                        
                        <!-- Availability -->
                        <div class="filter-section">
                            <h6>Availability</h6>
                            <label style="display: block; margin-bottom: 8px; font-size: 12px; color: #3F3040; cursor: pointer;">
                                <input type="radio" name="availability" value="in-stock" <%= filters.availability === 'in-stock' ? 'checked' : '' %> onchange="this.form.submit()"> In Stock Only
                            </label>
                            <label style="display: block; font-size: 12px; color: #3F3040; cursor: pointer;">
                                <input type="radio" name="availability" value="sale" <%= filters.availability === 'sale' ? 'checked' : '' %> onchange="this.form.submit()"> On Sale
                            </label>
                        </div>
                        
                        <!-- Sort (also here for mobile) -->
                        <div class="filter-section">
                            <h6>Sort By</h6>
                            <select name="sort" class="sort-select" style="width: 100%;" onchange="this.form.submit()">
                                <option value="newest" <%= filters.sort === 'newest' || !filters.sort ? 'selected' : '' %>>Newest First</option>
                                <option value="price-asc" <%= filters.sort === 'price-asc' ? 'selected' : '' %>>Price: Low to High</option>
                                <option value="price-desc" <%= filters.sort === 'price-desc' ? 'selected' : '' %>>Price: High to Low</option>
                                <option value="popular" <%= filters.sort === 'popular' ? 'selected' : '' %>>Most Popular</option>
                            </select>
                        </div>
                        
                        <button type="submit" class="apply-btn">Apply Filters</button>
                    </form>
                </div>
            </div>
            
            <!-- Products -->
            <div class="col-md-9">
                <!-- Sort Bar -->
                <div class="sort-bar">
                    <p>Showing <strong><%= products.length %></strong> product<%= products.length !== 1 ? 's' : '' %></p>
                    <select class="sort-select" onchange="window.location.href = this.value">
                        <option value="">Sort By</option>
                        <option value="/category/<%= category %>?<%= currentSub !== 'all' ? 'sub=' + currentSub + '&' : '' %>sort=newest">Newest First</option>
                        <option value="/category/<%= category %>?<%= currentSub !== 'all' ? 'sub=' + currentSub + '&' : '' %>sort=price-asc">Price: Low to High</option>
                        <option value="/category/<%= category %>?<%= currentSub !== 'all' ? 'sub=' + currentSub + '&' : '' %>sort=price-desc">Price: High to Low</option>
                    </select>
                </div>
                
                <% if (products.length > 0) { %>
                    <div class="row">
                        <% products.forEach(function(product) { %>
                            <% var totalStock = 0; %>
                            <% if (product.variations && product.variations.length > 0) { %>
                                <% product.variations.forEach(function(v) { totalStock += v.stock; }); %>
                            <% } else { %>
                                <% totalStock = product.stock; %>
                            <% } %>
                            
                            <div class="col-6 col-md-4 mb-4">
                                <a href="/product/<%= product.slug %>" class="product-card">
                                    <div class="product-image-wrapper">
                                        <% if (product.salePrice) { %>
                                            <span class="product-badge sale">SALE</span>
                                            <span class="discount-badge">-<%= Math.round(((product.price - product.salePrice) / product.price) * 100) %>%</span>
                                        <% } %>
                                        <% if (product.images && product.images.length > 0) { %>
                                            <img src="<%= product.images[0] %>" class="product-image" alt="<%= product.name %>">
                                        <% } else { %>
                                            <div class="product-image d-flex align-items-center justify-content-center">
                                                <i class="bi bi-image" style="font-size: 40px; color: #C9A45C;"></i>
                                            </div>
                                        <% } %>
                                        <% if (totalStock === 0) { %>
                                            <div class="sold-out-overlay">SOLD OUT</div>
                                        <% } %>
                                    </div>
                                    <div class="product-info">
                                        <div class="product-name"><%= product.name %></div>
                                        <% if (product.salePrice) { %>
                                            <span class="product-price">Rs. <%= product.salePrice.toLocaleString() %></span>
                                            <span class="product-original-price">Rs. <%= product.price.toLocaleString() %></span>
                                        <% } else { %>
                                            <span class="product-price">Rs. <%= product.price.toLocaleString() %></span>
                                        <% } %>
                                    </div>
                                </a>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <i class="bi bi-search"></i>
                        <h3>No Products Found</h3>
                        <p>Try adjusting your filters or browse other categories.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Footer -->
<%- include('partials/footer') %>

    <a href="https://wa.me/923277985292" class="whatsapp-btn" target="_blank">
        <i class="bi bi-whatsapp"></i>
    </a>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>