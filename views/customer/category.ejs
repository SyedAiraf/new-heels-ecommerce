<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - New Heels</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/category.css" rel="stylesheet">
</head>
<body>
    <% if (session && session.adminId) { %>
        <a href="/admin/dashboard" style="position: fixed; bottom: 20px; left: 20px; background: #8B6688; color: white; padding: 12px 20px; text-decoration: none; font-weight: 500; z-index: 9999; display: flex; align-items: center; gap: 8px; font-size: 13px;">
            <i class="bi bi-speedometer2"></i> Back to Admin
        </a>
    <% } %>

    <!-- Header -->
    <div class="header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-4 col-md-3">
                    <a href="/" class="logo"><img src="/images/logo.jpg" alt="New Heels"></a>
                </div>
                <div class="col-md-6 d-none d-md-block">
                    <form class="search-bar mx-auto" action="/search" method="GET">
                        <input type="text" name="q" placeholder="Search for shoes, bags..." required>
                        <button type="submit"><i class="bi bi-search"></i></button>
                    </form>
                </div>
                <div class="col-8 col-md-3 text-end">
                    <div class="header-icons justify-content-end">
                        <a href="/cart" class="header-icon">
                            <i class="bi bi-cart"></i>
                            <span class="badge"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Navigation -->
    <div class="category-nav">
        <div class="container">
            <div class="d-flex justify-content-center flex-wrap">
                <a href="/">HOME</a>
                <a href="/category/female">WOMEN</a>
                <a href="/category/men">MEN</a>
                <a href="/category/kids">KIDS</a>
                <a href="/category/female?sub=shoes-sandals">SALE</a>
                <a href="/category/female?sub=bags-purses">NEW ARRIVALS</a>
                <a href="/track-order">TRACK ORDER</a>
            </div>
        </div>
    </div>

    <!-- Page Header -->
    <div class="page-header">
        <div class="container">
            <h1><%= category.charAt(0).toUpperCase() + category.slice(1) %>'s Collection</h1>
            <p>Discover our exclusive range</p>
        </div>
    </div>

    <!-- Subcategory Tabs -->
    <div class="container">
        <div class="subcat-tabs">
            <a href="/category/<%= category %>" class="subcat-tab <%= currentSub === 'all' ? 'active' : '' %>">
                All (<%= subcategoryCounts.all || 0 %>)
            </a>
            
            <% if (category === 'men') { %>
                <a href="/category/men?sub=shoes" class="subcat-tab <%= currentSub === 'shoes' ? 'active' : '' %>">Shoes (<%= subcategoryCounts.shoes || 0 %>)</a>
                <a href="/category/men?sub=chappals" class="subcat-tab <%= currentSub === 'chappals' ? 'active' : '' %>">Chappals (<%= subcategoryCounts.chappals || 0 %>)</a>
                <a href="/category/men?sub=peshawri" class="subcat-tab <%= currentSub === 'peshawri' ? 'active' : '' %>">Peshawri (<%= subcategoryCounts.peshawri || 0 %>)</a>
            <% } %>
            
            <% if (category === 'kids') { %>
                <a href="/category/kids?sub=toddler" class="subcat-tab <%= currentSub === 'toddler' ? 'active' : '' %>">Toddler (<%= subcategoryCounts.toddler || 0 %>)</a>
                <a href="/category/kids?sub=little-kids" class="subcat-tab <%= currentSub === 'little-kids' ? 'active' : '' %>">Little Kids (<%= subcategoryCounts['little-kids'] || 0 %>)</a>
                <a href="/category/kids?sub=big-kids" class="subcat-tab <%= currentSub === 'big-kids' ? 'active' : '' %>">Big Kids (<%= subcategoryCounts['big-kids'] || 0 %>)</a>
            <% } %>
            
            <% if (category === 'female') { %>
                <a href="/category/female?sub=bags-purses" class="subcat-tab <%= currentSub === 'bags-purses' ? 'active' : '' %>">Bags & Purses (<%= subcategoryCounts['bags-purses'] || 0 %>)</a>
                <a href="/category/female?sub=shoes-sandals" class="subcat-tab <%= currentSub === 'shoes-sandals' ? 'active' : '' %>">Shoes & Sandals (<%= subcategoryCounts['shoes-sandals'] || 0 %>)</a>
            <% } %>
        </div>
    </div>

    <!-- Products Grid -->
    <div class="container mb-5">
        <% if (products.length > 0) { %>
            <div class="row">
                <% products.forEach(function(product) { %>
                    <% var totalStock = 0; %>
                    <% if (product.variations && product.variations.length > 0) { %>
                        <% product.variations.forEach(function(v) { totalStock += v.stock; }); %>
                    <% } else { %>
                        <% totalStock = product.stock; %>
                    <% } %>
                    
                    <div class="col-6 col-md-3">
                        <a href="/product/<%= product.slug %>" class="product-card">
                            <div class="product-image-wrapper">
                                <% if (product.salePrice) { %>
                                    <span class="product-badge sale">SALE</span>
                                    <span class="discount-badge">-<%= Math.round(((product.price - product.salePrice) / product.price) * 100) %>%</span>
                                <% } %>
                                <% if (product.images && product.images.length > 0) { %>
                                    <img src="<%= product.images[0] %>" class="product-image" alt="<%= product.name %>">
                                <% } else { %>
                                    <div class="product-image d-flex align-items-center justify-content-center" style="background: #F8F3EF;">
                                        <i class="bi bi-image" style="font-size: 40px; color: #C9A45C;"></i>
                                    </div>
                                <% } %>
                                <% if (totalStock === 0) { %>
                                    <div class="sold-out-overlay">SOLD OUT</div>
                                <% } %>
                            </div>
                            <div class="product-info">
                                <div class="product-name"><%= product.name %></div>
                                <% if (product.salePrice) { %>
                                    <span class="product-price">Rs. <%= product.salePrice.toLocaleString() %></span>
                                    <span class="product-original-price">Rs. <%= product.price.toLocaleString() %></span>
                                <% } else { %>
                                    <span class="product-price">Rs. <%= product.price.toLocaleString() %></span>
                                <% } %>
                            </div>
                        </a>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <i class="bi bi-box"></i>
                <h3>No Products Found</h3>
                <p>Check back soon for new arrivals!</p>
            </div>
        <% } %>
    </div>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <!-- Mobile Bottom Navigation -->
    <div class="mobile-nav">
        <a href="/"><i class="bi bi-house"></i> Home</a>
        <a href="/category/female"><i class="bi bi-heart"></i> Women</a>
        <a href="/category/men"><i class="bi bi-person"></i> Men</a>
        <a href="/category/kids"><i class="bi bi-emoji-smile"></i> Kids</a>
        <a href="/cart" style="position: relative;">
            <i class="bi bi-cart"></i> Cart
            <span class="mobile-cart-badge"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>
        </a>
    </div>

    <!-- WhatsApp Button -->
    <a href="https://wa.me/923277985292?text=Hello%20New%20Heels" class="whatsapp-btn" target="_blank">
        <i class="bi bi-whatsapp"></i>
    </a>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>

    <!-- 3D SCROLL ANIMATIONS -->
    <script>
    function initCategoryAnimations() {
        const animatedElements = document.querySelectorAll(
            '.page-header, .subcat-tabs, .subcat-tab, .product-card, .empty-state'
        );
        
        if (animatedElements.length === 0) return;
        
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    const element = entry.target;
                    const siblings = Array.from(element.parentElement.children);
                    const index = siblings.indexOf(element);
                    
                    let delay = 0;
                    
                    if (element.classList.contains('product-card')) {
                        delay = Math.min(index * 120, 1000);
                    } else if (element.classList.contains('subcat-tab')) {
                        delay = Math.min(index * 100, 400);
                    }
                    
                    setTimeout(function() {
                        element.classList.add('animate-in');
                    }, delay);
                    
                    observer.unobserve(element);
                }
            });
        }, {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        });
        
        animatedElements.forEach(function(el) {
            observer.observe(el);
        });
    }
    
    document.addEventListener('DOMContentLoaded', function() {
        setTimeout(initCategoryAnimations, 100);
    });
    </script>
</body>
</html>