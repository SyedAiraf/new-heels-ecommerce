<!-- Size Chart Script -->
<script>
    function openSizeChart() {
        document.getElementById('sizeChartModal').style.display = 'block';
        document.body.style.overflow = 'hidden';
    }
    
    function closeSizeChart() {
        document.getElementById('sizeChartModal').style.display = 'none';
        document.body.style.overflow = 'auto';
    }
    
    // Close on clicking outside the modal
    document.getElementById('sizeChartModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeSizeChart();
        }
    });
    
    // Close on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeSizeChart();
        }
    });
</script>
<script>
    // ============ STAR RATING PICKER ============
    let selectedRating = 0;
    
    function setRating(value) {
        selectedRating = value;
        
        // Update hidden input (this is what gets submitted)
        document.getElementById('ratingInput').value = value;
        
        // Update star display
        const stars = document.querySelectorAll('#starPicker .star-item');
        stars.forEach(star => {
            const starValue = parseInt(star.dataset.value);
            if (starValue <= value) {
                star.classList.remove('bi-star');
                star.classList.add('bi-star-fill');
            } else {
                star.classList.remove('bi-star-fill');
                star.classList.add('bi-star');
            }
        });
        
        // Update text below stars
        const textMap = {
            1: 'Poor',
            2: 'Fair',
            3: 'Good',
            4: 'Very Good',
            5: 'Excellent'
        };
        document.getElementById('ratingText').textContent = textMap[value] || '';
    }
    
    // Hover effect — preview fill on hover
    document.querySelectorAll('#starPicker .star-item').forEach(star => {
        star.addEventListener('mouseenter', function() {
            const hoverValue = parseInt(this.dataset.value);
            const stars = document.querySelectorAll('#starPicker .star-item');
            stars.forEach(s => {
                const starValue = parseInt(s.dataset.value);
                if (starValue <= hoverValue) {
                    s.classList.remove('bi-star');
                    s.classList.add('bi-star-fill');
                } else {
                    s.classList.remove('bi-star-fill');
                    s.classList.add('bi-star');
                }
            });
        });
    });
    
    // Reset to selected on mouse leave
    document.getElementById('starPicker').addEventListener('mouseleave', function() {
        const stars = document.querySelectorAll('#starPicker .star-item');
        stars.forEach(star => {
            const starValue = parseInt(star.dataset.value);
            if (starValue <= selectedRating) {
                star.classList.remove('bi-star');
                star.classList.add('bi-star-fill');
            } else {
                star.classList.remove('bi-star-fill');
                star.classList.add('bi-star');
            }
        });
    });
</script>
</body>
