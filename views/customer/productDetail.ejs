<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> - New Heels</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link href="/css/product.css" rel="stylesheet">
</head>
<body>
    <% if (session && session.adminId) { %>
        <a href="/admin/dashboard" style="position: fixed; bottom: 20px; left: 20px; background: #8B6688; color: white; padding: 12px 20px; text-decoration: none; font-weight: 500; z-index: 9999; display: flex; align-items: center; gap: 8px; font-size: 13px;">
            <i class="bi bi-speedometer2"></i> Back to Admin
        </a>
    <% } %>

    <!-- Header -->
    <div class="header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-4 col-md-3">
                    <a href="/" class="logo"><img src="/images/logo.jpg" alt="New Heels"></a>
                </div>
                <div class="col-md-6 d-none d-md-block">
                    <form class="search-bar mx-auto" action="/search" method="GET">
                        <input type="text" name="q" placeholder="Search for shoes, bags..." required>
                        <button type="submit"><i class="bi bi-search"></i></button>
                    </form>
                </div>
                <div class="col-8 col-md-3 text-end">
                    <div class="header-icons justify-content-end">
                        <a href="/cart" class="header-icon">
                            <i class="bi bi-cart"></i>
                            <span class="badge"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Navigation -->
    <div class="category-nav">
        <div class="container">
            <div class="d-flex justify-content-center flex-wrap">
                <a href="/">HOME</a>
                <a href="/category/female">WOMEN</a>
                <a href="/category/men">MEN</a>
                <a href="/category/kids">KIDS</a>
                <a href="/category/female?sub=shoes-sandals">SALE</a>
                <a href="/category/female?sub=bags-purses">NEW ARRIVALS</a>
            </div>
        </div>
    </div>

    <!-- Product Detail -->
    <section class="product-detail-section">
        <div class="container">
            <div class="row">
                <!-- Left: Images -->
                <div class="col-md-6">
                    <% if (product.images && product.images.length > 0) { %>
                        <div class="main-image-wrapper">
                            <img src="<%= product.images[0] %>" class="main-image" id="mainImage" alt="<%= product.name %>">
                            <% if (product.images.length > 1) { %>
                                <button class="image-nav-btn image-nav-prev" onclick="prevImage()">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                <button class="image-nav-btn image-nav-next" onclick="nextImage()">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                                <div class="image-dots" id="imageDots">
                                    <% product.images.forEach(function(img, idx) { %>
                                        <span class="image-dot <%= idx === 0 ? 'active' : '' %>" onclick="goToImage(<%= idx %>)"></span>
                                    <% }); %>
                                </div>
                            <% } %>
                        </div>
                        <div class="thumbnail-images">
                            <% product.images.forEach(function(image, index) { %>
                                <img src="<%= image %>" class="thumbnail <%= index === 0 ? 'active' : '' %>" onclick="goToImage(<%= index %>)" alt="Thumbnail <%= index + 1 %>">
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="main-image d-flex align-items-center justify-content-center">
                            <i class="bi bi-image" style="font-size: 60px; color: #C9A45C;"></i>
                        </div>
                    <% } %>
                </div>

                <!-- Right: Product Info -->
                <div class="col-md-6">
                    <div class="product-category">
                        <%= product.category.charAt(0).toUpperCase() + product.category.slice(1) %>'s <%= product.type === 'shoe' ? 'Shoe' : 'Bag' %>
                    </div>
                    <h1 class="product-title"><%= product.name %></h1>

                    <div class="price-section">
                        <% if (product.salePrice) { %>
                            <span class="current-price">Rs. <%= product.salePrice.toLocaleString() %></span>
                            <span class="original-price">Rs. <%= product.price.toLocaleString() %></span>
                            <span class="discount-badge-detail">-<%= Math.round(((product.price - product.salePrice) / product.price) * 100) %>%</span>
                        <% } else { %>
                            <span class="current-price">Rs. <%= product.price.toLocaleString() %></span>
                        <% } %>
                    </div>

                    <!-- Stock Status -->
                    <% var totalStock = 0; %>
                    <% if (product.variations && product.variations.length > 0) { %>
                        <% product.variations.forEach(function(v) { totalStock += v.stock; }); %>
                    <% } else { %>
                        <% totalStock = product.stock; %>
                    <% } %>

                    <% if (totalStock > 0) { %>
                        <div class="stock-status in-stock"><i class="bi bi-check-circle"></i> In Stock</div>
                    <% } else { %>
                        <div class="stock-status out-of-stock"><i class="bi bi-x-circle"></i> Sold Out</div>
                    <% } %>

                    <!-- Size Chart Link -->
                    <% if (product.type === 'shoe' && product.variations && product.variations.length > 0) { %>
                        <div style="margin: 15px 0 10px;">
                            <button type="button" class="size-chart-link" onclick="openSizeChart()">
                                <i class="bi bi-rulers"></i> Size Chart
                            </button>
                        </div>

                        <div class="size-selector">
                            <h6>Select Size:</h6>
                            <% product.variations.forEach(function(variation) { %>
                                <button class="size-btn" onclick="selectSize(this)"><%= variation.size %></button>
                            <% }); %>
                        </div>
                    <% } %>

                    <!-- Quantity -->
                    <div class="quantity-wrapper">
                        <label>Quantity:</label>
                        <div class="quantity-control">
                            <button class="quantity-btn" onclick="changeQty(-1)">−</button>
                            <input type="text" id="quantity" class="quantity-input" value="1" readonly>
                            <button class="quantity-btn" onclick="changeQty(1)">+</button>
                        </div>
                    </div>

                    <!-- Add to Cart -->
                    <% if (totalStock > 0) { %>
                        <button class="btn-add-to-cart" onclick="addToCart('<%= product._id %>', '<%= product.type %>')">
                            <i class="bi bi-cart-plus me-2"></i> Add to Cart
                        </button>
                    <% } else { %>
                        <button class="btn-add-to-cart" disabled style="background: #ccc; cursor: not-allowed;">Sold Out</button>
                    <% } %>
                </div>
            </div>
        </div>
    </section>

    <!-- Expandable Sections -->
    <section class="accordion-section">
        <div class="container">
            
            <!-- Return & Exchange -->
            <div class="accordion-item" onclick="toggleAccordion(this)">
                <div class="accordion-header">
                    <div class="accordion-title">
                        <i class="bi bi-arrow-repeat"></i>
                        <span>Refund & Exchange Policy</span>
                    </div>
                    <i class="bi bi-plus accordion-icon"></i>
                </div>
                <div class="accordion-content">
                    <div class="accordion-content-inner">
                        <ul>
                            <li>7-day easy returns & exchanges</li>
                            <li>Product must be unused with original packaging</li>
                            <li>Refund processed within 5-7 business days</li>
                            <li>Free size exchange available</li>
                            <li>Contact WhatsApp: <strong>0327 7985292</strong></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Product Description -->
            <div class="accordion-item active" onclick="toggleAccordion(this)">
                <div class="accordion-header">
                    <div class="accordion-title">
                        <i class="bi bi-file-text"></i>
                        <span>Product Description</span>
                    </div>
                    <i class="bi bi-dash accordion-icon"></i>
                </div>
                <div class="accordion-content">
                    <div class="accordion-content-inner">
                        <p><%= product.description %></p>
                    </div>
                </div>
            </div>

            <!-- Product Information -->
            <div class="accordion-item" onclick="toggleAccordion(this)">
                <div class="accordion-header">
                    <div class="accordion-title">
                        <i class="bi bi-info-circle"></i>
                        <span>Product Information</span>
                    </div>
                    <i class="bi bi-plus accordion-icon"></i>
                </div>
                <div class="accordion-content">
                    <div class="accordion-content-inner">
                        <div class="info-row">
                            <span class="info-label">Category</span>
                            <span class="info-value"><%= product.category.charAt(0).toUpperCase() + product.category.slice(1) %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Type</span>
                            <span class="info-value"><%= product.type === 'shoe' ? 'Shoe' : 'Bag' %></span>
                        </div>
                        <% if (product.variations && product.variations.length > 0) { %>
                            <div class="info-row">
                                <span class="info-label">Available Sizes</span>
                                <span class="info-value">
                                    <% var sizes = product.variations.map(v => v.size).filter(s => s); %>
                                    <%= sizes.join(', ') || 'N/A' %>
                                </span>
                            </div>
                            <div class="info-row">
                                <span class="info-label">Available Colors</span>
                                <span class="info-value">
                                    <% var colors = [...new Set(product.variations.map(v => v.color).filter(c => c))]; %>
                                    <%= colors.join(', ') || 'N/A' %>
                                </span>
                            </div>
                            <% var skus = product.variations.map(v => v.sku).filter(s => s); %>
                            <% if (skus.length > 0) { %>
                                <div class="info-row">
                                    <span class="info-label">SKU</span>
                                    <span class="info-value"><%= skus.join(', ') %></span>
                                </div>
                            <% } %>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Delivery & Returns -->
            <div class="accordion-item" onclick="toggleAccordion(this)">
                <div class="accordion-header">
                    <div class="accordion-title">
                        <i class="bi bi-truck"></i>
                        <span>Delivery & Returns</span>
                    </div>
                    <i class="bi bi-plus accordion-icon"></i>
                </div>
                <div class="accordion-content">
                    <div class="accordion-content-inner">
                        <h6>Delivery</h6>
                        <ul>
                            <li>Karachi: 1-2 business days</li>
                            <li>Major Cities: 2-3 business days</li>
                            <li>Other Areas: 3-5 business days</li>
                            <li>Free shipping over Rs. 4,000</li>
                            <li>COD available across Pakistan</li>
                        </ul>
                        <h6>Returns</h6>
                        <ul>
                            <li>7-day return policy</li>
                            <li>Easy size exchange</li>
                            <li>Product must be unused</li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- Customer Reviews Section -->
    <section class="reviews-section" id="reviews">
        <div class="container">
            <div class="reviews-wrapper">
                <div class="rating-summary">
                    <div class="rating-summary-left">
                        <div class="rating-big"><%= averageRating || '0.0' %></div>
                        <div class="rating-stars-big">
                            <% for (var i = 1; i <= 5; i++) { %>
                                <i class="bi bi-star<%= i <= Math.round(averageRating) ? '-fill' : '' %>"></i>
                            <% } %>
                        </div>
                        <div class="rating-count">Based on <strong><%= reviewCount %></strong> reviews</div>
                    </div>
                    <div class="rating-summary-right">
                        <% for (var star = 5; star >= 1; star--) { %>
                            <% var count = ratingCounts[star] || 0; %>
                            <% var percentage = reviewCount > 0 ? (count / reviewCount) * 100 : 0; %>
                            <div class="rating-bar-row">
                                <span class="rating-bar-label"><%= star %> <i class="bi bi-star-fill"></i></span>
                                <div class="rating-bar"><div class="rating-bar-fill" style="width: <%= percentage %>%;"></div></div>
                                <span class="rating-bar-count"><%= count %></span>
                            </div>
                        <% } %>
                    </div>
                </div>

                <% if (typeof reviewSuccess !== 'undefined' && reviewSuccess) { %>
                    <div class="review-alert success"><i class="bi bi-check-circle me-2"></i>Thank you! Your review has been submitted.</div>
                <% } %>
                <% if (typeof reviewError !== 'undefined' && reviewError) { %>
                    <div class="review-alert error"><i class="bi bi-exclamation-circle me-2"></i><%= reviewError %></div>
                <% } %>

                <div class="reviews-list">
                    <h3 class="reviews-heading"><i class="bi bi-chat-quote"></i> Customer Reviews</h3>
                    <% if (reviews && reviews.length > 0) { %>
                        <% reviews.forEach(function(review) { %>
                            <div class="review-item">
                                <div class="review-header">
                                    <div class="reviewer-info">
                                        <div class="reviewer-avatar"><%= review.name.charAt(0).toUpperCase() %></div>
                                        <div>
                                            <div class="reviewer-name"><%= review.name %></div>
                                            <div class="review-date"><%= review.createdAt.toLocaleDateString('en-PK', { year: 'numeric', month: 'long', day: 'numeric' }) %></div>
                                        </div>
                                    </div>
                                    <div class="review-stars">
                                        <% for (var i = 1; i <= 5; i++) { %>
                                            <i class="bi bi-star<%= i <= review.rating ? '-fill' : '' %>"></i>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="review-comment"><%= review.comment %></div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="no-reviews">
                            <i class="bi bi-chat-square-text"></i>
                            <p>No reviews yet. Be the first to review this product!</p>
                        </div>
                    <% } %>
                </div>

                <div class="write-review">
                    <h3 class="reviews-heading"><i class="bi bi-pencil-square"></i> Write a Review</h3>
                    <form action="/product/<%= product.slug %>/review" method="POST">
                        <div class="form-group">
                            <label class="form-label">Your Rating *</label>
                            <div class="star-picker" id="starPicker">
                                <i class="bi bi-star star-item" data-value="1" onclick="setRating(1)"></i>
                                <i class="bi bi-star star-item" data-value="2" onclick="setRating(2)"></i>
                                <i class="bi bi-star star-item" data-value="3" onclick="setRating(3)"></i>
                                <i class="bi bi-star star-item" data-value="4" onclick="setRating(4)"></i>
                                <i class="bi bi-star star-item" data-value="5" onclick="setRating(5)"></i>
                            </div>
                            <input type="hidden" name="rating" id="ratingInput" required>
                            <div id="ratingText" style="color: #8B6688; font-size: 12px; margin-top: 8px;"></div>
                        </div>
                        <div class="form-row-two">
                            <div class="form-group">
                                <label class="form-label">Your Name *</label>
                                <input type="text" class="form-input" name="name" placeholder="e.g., Ali Khan" required maxlength="50">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Your Email *</label>
                                <input type="email" class="form-input" name="email" placeholder="your@email.com" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Your Review *</label>
                            <textarea class="form-input" name="comment" rows="5" placeholder="Share your experience..." required maxlength="500"></textarea>
                        </div>
                        <button type="submit" class="submit-review-btn"><i class="bi bi-send me-2"></i>Submit Review</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Related Products -->
    <% if (relatedProducts.length > 0) { %>
    <section class="related-section">
        <div class="container">
            <h3 class="mb-4">You May Also Like</h3>
            <div class="row">
                <% relatedProducts.forEach(function(related) { %>
                    <div class="col-6 col-md-3">
                        <a href="/product/<%= related.slug %>" class="related-card">
                            <% if (related.images && related.images.length > 0) { %>
                                <img src="<%= related.images[0] %>" class="related-image" alt="<%= related.name %>">
                            <% } %>
                            <div class="related-info">
                                <div class="related-name"><%= related.name %></div>
                                <span class="related-price">Rs. <%= (related.salePrice || related.price).toLocaleString() %></span>
                            </div>
                        </a>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- Size Chart Modal -->
    <div id="sizeChartModal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(63, 48, 64, 0.75); z-index: 99999; padding: 20px; overflow-y: auto;">
        <div style="max-width: 700px; margin: 40px auto; background: white; border-top: 4px solid #C9A45C; padding: 40px; position: relative;">
            <button onclick="closeSizeChart()" style="position: absolute; top: 15px; right: 15px; background: none; border: none; font-size: 24px; color: #8B6688; cursor: pointer;">
                <i class="bi bi-x"></i>
            </button>
            <div style="text-align: center; margin-bottom: 35px;">
                <h2 style="color: #3F3040; font-weight: 700; font-size: 24px; letter-spacing: 3px; text-transform: uppercase; margin: 0;">
                    <i class="bi bi-rulers" style="color: #C9A45C;"></i> Size Guide
                </h2>
                <p style="color: #8B6688; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; margin-top: 10px;">Find your perfect fit</p>
            </div>

            <% if (product.category === 'female') { %>
            <h4 style="color: #3F3040; font-size: 13px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; padding-bottom: 10px; border-bottom: 2px solid #C9A45C; margin-bottom: 15px;">Women's Shoes & Heels</h4>
            <table style="width: 100%; border-collapse: collapse;">
                <thead><tr style="background: #F8F3EF;"><th style="padding: 12px; text-align: left; font-size: 11px;">EU</th><th style="padding: 12px; text-align: center; font-size: 11px;">UK</th><th style="padding: 12px; text-align: center; font-size: 11px;">US</th><th style="padding: 12px; text-align: right; font-size: 11px;">CM</th></tr></thead>
                <tbody>
                    <tr style="border-bottom: 1px solid #F8F3EF;"><td style="padding: 12px;">36</td><td style="padding: 12px; text-align: center;">3</td><td style="padding: 12px; text-align: center;">5</td><td style="padding: 12px; text-align: right;">22.5</td></tr>
                    <tr style="border-bottom: 1px solid #F8F3EF;"><td style="padding: 12px;">37</td><td style="padding: 12px; text-align: center;">4</td><td style="padding: 12px; text-align: center;">6</td><td style="padding: 12px; text-align: right;">23.5</td></tr>
                    <tr style="border-bottom: 1px solid #F8F3EF;"><td style="padding: 12px;">38</td><td style="padding: 12px; text-align: center;">5</td><td style="padding: 12px; text-align: center;">7</td><td style="padding: 12px; text-align: right;">24</td></tr>
                    <tr style="border-bottom: 1px solid #F8F3EF;"><td style="padding: 12px;">39</td><td style="padding: 12px; text-align: center;">6</td><td style="padding: 12px; text-align: center;">8</td><td style="padding: 12px; text-align: right;">25</td></tr>
                    <tr style="border-bottom: 1px solid #F8F3EF;"><td style="padding: 12px;">40</td><td style="padding: 12px; text-align: center;">7</td><td style="padding: 12px; text-align: center;">9</td><td style="padding: 12px; text-align: right;">25.5</td></tr>
                    <tr style="border-bottom: 1px solid #F8F3EF;"><td style="padding: 12px;">41</td><td style="padding: 12px; text-align: center;">8</td><td style="padding: 12px; text-align: center;">10</td><td style="padding: 12px; text-align: right;">26.5</td></tr>
                </tbody>
            </table>
            <% } %>

            <% if (product.category === 'men') { %>
            <h4 style="color: #3F3040; font-size: 13px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; padding-bottom: 10px; border-bottom: 2px solid #C9A45C; margin-bottom: 15px;">Men's Shoes</h4>
            <table style="width: 100%; border-collapse: collapse;">
                <thead><tr style="background: #F8F3EF;"><th style="padding: 12px; text-align: left; font-size: 11px;">EU</th><th style="padding: 12px; text-align: center; font-size: 11px;">UK</th><th style="padding: 12px; text-align: center; font-size: 11px;">US</th><th style="padding: 12px; text-align: right; font-size: 11px;">CM</th></tr></thead>
                <tbody>
                    <tr style="border-bottom: 1px solid #F8F3EF;"><td style="padding: 12px;">40</td><td style="padding: 12px; text-align: center;">6</td><td style="padding: 12px; text-align: center;">7</td><td style="padding: 12px; text-align: right;">25</td></tr>
                    <tr style="border-bottom: 1px solid #F8F3EF;"><td style="padding: 12px;">41</td><td style="padding: 12px; text-align: center;">7</td><td style="padding: 12px; text-align: center;">8</td><td style="padding: 12px; text-align: right;">25.5</td></tr>
                    <tr style="border-bottom: 1px solid #F8F3EF;"><td style="padding: 12px;">42</td><td style="padding: 12px; text-align: center;">8</td><td style="padding: 12px; text-align: center;">9</td><td style="padding: 12px; text-align: right;">26.5</td></tr>
                    <tr style="border-bottom: 1px solid #F8F3EF;"><td style="padding: 12px;">43</td><td style="padding: 12px; text-align: center;">9</td><td style="padding: 12px; text-align: center;">10</td><td style="padding: 12px; text-align: right;">27.5</td></tr>
                    <tr style="border-bottom: 1px solid #F8F3EF;"><td style="padding: 12px;">44</td><td style="padding: 12px; text-align: center;">10</td><td style="padding: 12px; text-align: center;">11</td><td style="padding: 12px; text-align: right;">28</td></tr>
                    <tr style="border-bottom: 1px solid #F8F3EF;"><td style="padding: 12px;">45</td><td style="padding: 12px; text-align: center;">11</td><td style="padding: 12px; text-align: center;">12</td><td style="padding: 12px; text-align: right;">29</td></tr>
                </tbody>
            </table>
            <% } %>

            <% if (product.category === 'kids') { %>
            <h4 style="color: #3F3040; font-size: 13px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; padding-bottom: 10px; border-bottom: 2px solid #C9A45C; margin-bottom: 15px;">Kids' Shoes</h4>
            <table style="width: 100%; border-collapse: collapse;">
                <thead><tr style="background: #F8F3EF;"><th style="padding: 12px; text-align: left; font-size: 11px;">Age Group</th><th style="padding: 12px; text-align: center; font-size: 11px;">EU Size</th><th style="padding: 12px; text-align: right; font-size: 11px;">CM</th></tr></thead>
                <tbody>
                    <tr style="border-bottom: 1px solid #F8F3EF;"><td style="padding: 12px;">Toddler (1-4 yrs)</td><td style="padding: 12px; text-align: center;">20-26</td><td style="padding: 12px; text-align: right;">12-15</td></tr>
                    <tr style="border-bottom: 1px solid #F8F3EF;"><td style="padding: 12px;">Little Kids (4-8 yrs)</td><td style="padding: 12px; text-align: center;">27-33</td><td style="padding: 12px; text-align: right;">16-20</td></tr>
                    <tr style="border-bottom: 1px solid #F8F3EF;"><td style="padding: 12px;">Big Kids (8-12 yrs)</td><td style="padding: 12px; text-align: center;">34-38</td><td style="padding: 12px; text-align: right;">21-24</td></tr>
                </tbody>
            </table>
            <% } %>

