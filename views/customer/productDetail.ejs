    <script>
    // ============ PRODUCT IMAGE SLIDER ============
    const productImages = <%- JSON.stringify(product.images || []) %>;
    let currentImageIndex = 0;
    let autoSlideInterval;

    function goToImage(index) {
        if (!productImages.length) return;
        currentImageIndex = index;
        document.getElementById('mainImage').src = productImages[index];
        
        document.querySelectorAll('.image-dot').forEach((d, i) => {
            d.classList.toggle('active', i === index);
        });
        
        document.querySelectorAll('.thumbnail').forEach((t, i) => {
            t.classList.toggle('active', i === index);
        });
        
        resetAutoSlide();
    }
    
    function nextImage() {
        if (!productImages.length) return;
        goToImage((currentImageIndex + 1) % productImages.length);
    }
    
    function prevImage() {
        if (!productImages.length) return;
        goToImage((currentImageIndex - 1 + productImages.length) % productImages.length);
    }
    
    function startAutoSlide() {
        if (productImages.length > 1) {
            autoSlideInterval = setInterval(() => {
                nextImage();
            }, 3000);
        }
    }
    
    function resetAutoSlide() {
        clearInterval(autoSlideInterval);
        startAutoSlide();
    }
    
    startAutoSlide();

    // ============ ACCORDION ============
    function toggleAccordion(element) {
        const wasActive = element.classList.contains('active');
        
        document.querySelectorAll('.accordion-item').forEach(item => {
            item.classList.remove('active');
            const icon = item.querySelector('.accordion-icon');
            if (icon) icon.className = 'bi bi-plus accordion-icon';
        });
        
        if (!wasActive) {
            element.classList.add('active');
            const icon = element.querySelector('.accordion-icon');
            if (icon) icon.className = 'bi bi-dash accordion-icon';
        }
    }

    // ============ STAR RATING ============
    let selectedRating = 0;
    
    function setRating(value) {
        selectedRating = value;
        document.getElementById('ratingInput').value = value;
        
        const stars = document.querySelectorAll('#starPicker .star-item');
        stars.forEach(star => {
            const starValue = parseInt(star.dataset.value);
            star.classList.toggle('bi-star-fill', starValue <= value);
            star.classList.toggle('bi-star', starValue > value);
        });
        
        const textMap = { 1: 'Poor', 2: 'Fair', 3: 'Good', 4: 'Very Good', 5: 'Excellent' };
        document.getElementById('ratingText').textContent = textMap[value] || '';
    }
    
    document.querySelectorAll('#starPicker .star-item').forEach(star => {
        star.addEventListener('mouseenter', function() {
            const hoverValue = parseInt(this.dataset.value);
            document.querySelectorAll('#starPicker .star-item').forEach(s => {
                const sv = parseInt(s.dataset.value);
                s.classList.toggle('bi-star-fill', sv <= hoverValue);
                s.classList.toggle('bi-star', sv > hoverValue);
            });
        });
    });
    
    document.getElementById('starPicker').addEventListener('mouseleave', function() {
        document.querySelectorAll('#starPicker .star-item').forEach(star => {
            const sv = parseInt(star.dataset.value);
            star.classList.toggle('bi-star-fill', sv <= selectedRating);
            star.classList.toggle('bi-star', sv > selectedRating);
        });
    });

    // ============ SIZE CHART MODAL ============
    function openSizeChart() {
        document.getElementById('sizeChartModal').style.display = 'block';
        document.body.style.overflow = 'hidden';
    }
    
    function closeSizeChart() {
        document.getElementById('sizeChartModal').style.display = 'none';
        document.body.style.overflow = 'auto';
    }
    
    document.getElementById('sizeChartModal').addEventListener('click', function(e) {
        if (e.target === this) closeSizeChart();
    });

    // ============ SCROLL ANIMATIONS ============
    function initProductAnimations() {
        const animatedElements = document.querySelectorAll(
            '.main-image-wrapper, .thumbnail-images, .product-category, .product-title, .price-section, .stock-status, .size-chart-link, .size-selector, .quantity-wrapper, .btn-add-to-cart, .accordion-item, .