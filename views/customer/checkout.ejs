<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure Checkout | New Heels</title>
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
<link rel="apple-touch-icon" href="/images/logo.jpg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <style>
        .checkout-section { padding: 50px 0; background: #F8F3EF; min-height: 80vh; }
        
        .page-header {
            background: #F8F3EF;
            padding: 50px 0;
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 1px solid #E8DFD5;
        }
        .page-header h1 {
            font-size: 32px;
            font-weight: 700;
            color: #3F3040;
            letter-spacing: 4px;
            text-transform: uppercase;
            margin-bottom: 10px;
        }
        .page-header p {
            color: #8B6688;
            font-size: 13px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        
        .checkout-card {
            background: white;
            padding: 30px;
            margin-bottom: 20px;
            border-top: 3px solid #C9A45C;
            box-shadow: 0 2px 15px rgba(63, 48, 64, 0.05);
        }
        
        .checkout-card h4 {
            color: #3F3040;
            font-weight: 600;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 1px solid #F8F3EF;
            font-size: 15px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        
        .form-label {
            color: #3F3040;
            font-weight: 500;
            font-size: 11px;
            margin-bottom: 8px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }
        
        .form-control {
            border: 1px solid #E8DFD5;
            padding: 12px 15px;
            font-size: 14px;
            background: #F8F3EF;
            color: #3F3040;
            border-radius: 0;
            transition: all 0.3s;
        }
        
        .form-control:focus {
            border-color: #8B6688;
            background: white;
            box-shadow: 0 0 0 3px rgba(139, 102, 136, 0.08);
            outline: none;
        }
        
        .form-control::placeholder {
            color: #B9A0C0;
        }
        
        .payment-option {
            border: 1px solid #E8DFD5;
            padding: 18px;
            margin-bottom: 12px;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            background: white;
        }
        
        .payment-option:hover {
            border-color: #8B6688;
            background: #F8F3EF;
        }
        
        .payment-option input {
            margin-right: 15px;
            accent-color: #8B6688;
            transform: scale(1.3);
        }
        
        .payment-option label {
            cursor: pointer;
            margin: 0;
            flex: 1;
            color: #3F3040;
            font-size: 14px;
            font-weight: 500;
        }
        
        .payment-option input:checked + label {
            color: #8B6688;
        }
        
        .order-summary {
            background: white;
            padding: 30px;
            position: sticky;
            top: 20px;
            border-top: 3px solid #C9A45C;
            box-shadow: 0 2px 15px rgba(63, 48, 64, 0.05);
        }
        
        .order-summary h4 {
            color: #3F3040;
            font-weight: 600;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 1px solid #F8F3EF;
            font-size: 15px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        
        .summary-item {
            display: flex;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid #F8F3EF;
        }
        
        .summary-item:last-child { border-bottom: none; }
        
        .summary-item img {
            width: 60px;
            height: 60px;
            object-fit: cover;
            background: #F8F3EF;
            border: 1px solid #F8F3EF;
            flex-shrink: 0;
        }
        
        .summary-item-info {
            flex: 1;
            min-width: 0;
        }
        
        .summary-item-name {
            font-weight: 500;
            color: #3F3040;
            font-size: 13px;
            margin-bottom: 4px;
        }
        
        .summary-item-details {
            color: #8B6688;
            font-size: 11px;
        }
        
        .summary-item-price {
            color: #8B6688;
            font-weight: 700;
            font-size: 13px;
            white-space: nowrap;
        }
        
        .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            font-size: 13px;
            color: #8B6688;
        }
        
        .summary-row.total {
            font-size: 18px;
            font-weight: 700;
            color: #3F3040;
            padding-top: 18px;
            border-top: 2px solid #F8F3EF;
            margin-top: 15px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        
        .summary-row.total .price {
            color: #8B6688;
            font-size: 22px;
        }
        
        .btn-place-order {
            background: #8B6688;
            color: white;
            border: none;
            padding: 16px;
            font-weight: 600;
            font-size: 13px;
            width: 100%;
            transition: all 0.3s;
            margin-top: 20px;
            letter-spacing: 3px;
            text-transform: uppercase;
            cursor: pointer;
        }
        
        .btn-place-order:hover {
            background: #3F3040;
            transform: translateY(-2px);
            box-shadow: 0 15px 30px rgba(63, 48, 64, 0.3);
        }
        
        .btn-back-cart {
            display: block;
            text-align: center;
            color: #8B6688;
            text-decoration: none;
            font-weight: 500;
            margin-top: 18px;
            font-size: 12px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        
        .btn-back-cart:hover { color: #3F3040; }
    </style>
</head>
<body>
    <% if (session && session.adminId) { %>
        <a href="/admin/dashboard" style="position: fixed; bottom: 20px; left: 20px; background: #8B6688; color: white; padding: 12px 20px; text-decoration: none; font-weight: 500; z-index: 9999; display: flex; align-items: center; gap: 8px; font-size: 13px;">
            <i class="bi bi-speedometer2"></i> Back to Admin
        </a>
    <% } %>

    <!-- Header -->
    <div class="header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-4 col-md-3">
                    <a href="/" class="logo"><img src="/images/logo.jpg" alt="New Heels"></a>
                </div>
                <div class="col-8 col-md-9 text-end">
                    <div class="header-icons justify-content-end">
                        <a href="/cart" class="header-icon">
                            <i class="bi bi-cart"></i>
                            <span class="badge"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Navigation -->
    <div class="category-nav">
        <div class="container">
            <div class="d-flex justify-content-center flex-wrap">
                <a href="/">HOME</a>
                <a href="/category/men">MEN</a>
                <a href="/category/kids">KIDS</a>
                <a href="/category/female">WOMEN</a>
                <a href="/category/female?sub=shoes-sandals">SALE</a>
                <a href="/category/female?sub=bags-purses">NEW ARRIVALS</a>
            </div>
        </div>
    </div>

    <!-- Page Header -->
    <div class="page-header">
        <div class="container">
            <h1>Checkout</h1>
            <p>Almost there! Complete your order</p>
        </div>
    </div>

    <!-- Checkout Content -->
    <div class="container checkout-section">
        <form action="/checkout" method="POST" id="checkoutForm">
            <div class="row">
                <!-- Left: Delivery Details -->
                <div class="col-md-7">
                    <!-- Customer Information -->
                    <div class="checkout-card">
                        <h4><i class="bi bi-person me-2"></i>Delivery Information</h4>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Full Name *</label>
                                <input type="text" class="form-control" name="name" placeholder="Enter your full name" required>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Phone Number *</label>
                                <input type="tel" class="form-control" name="phone" placeholder="03XX-XXXXXXX" required>
                            </div>
                            
                            <div class="col-12 mb-3">
                                <label class="form-label">Email Address *</label>
                                <input type="email" class="form-control" name="email" placeholder="your.email@example.com" required>
                            </div>
                            
                            <div class="col-12 mb-3">
                                <label class="form-label">Complete Address *</label>
                                <textarea class="form-control" name="address" rows="2" placeholder="House #, Street, Area" required></textarea>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label class="form-label">City *</label>
                                <input type="text" class="form-control" name="city" placeholder="e.g. Karachi" required>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Postal Code *</label>
                                <input type="text" class="form-control" name="postalCode" placeholder="e.g. 75500" required>
                            </div>
                            
                            <div class="col-12 mb-3">
                                <label class="form-label">Additional Notes (Optional)</label>
                                <textarea class="form-control" name="notes" rows="2" placeholder="Any special delivery instructions"></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Method -->
                    <div class="checkout-card">
                        <h4><i class="bi bi-credit-card me-2"></i>Payment Method</h4>
                        
                        <div class="payment-option">
                            <input type="radio" name="paymentMethod" id="cod" value="cod" checked>
                            <label for="cod">
                                <i class="bi bi-cash-coin me-2" style="font-size: 18px; color: #8B6688;"></i>
                                Cash on Delivery (COD)
                            </label>
                        </div>
                        
                        <div class="payment-option">
                            <input type="radio" name="paymentMethod" id="bank" value="bank_transfer">
                            <label for="bank">
                                <i class="bi bi-bank me-2" style="font-size: 18px; color: #8B6688;"></i>
                                Bank Transfer
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Right: Order Summary -->
                <div class="col-md-5">
                    <div class="order-summary">
                        <h4><i class="bi bi-bag-check me-2"></i>Order Summary</h4>
                        
                        <% cartItems.forEach(function(item) { %>
                            <div class="summary-item">
                                <img src="<%= item.image || 'https://via.placeholder.com/60/F8F3EF/8B6688?text=P' %>" alt="<%= item.name %>">
                                <div class="summary-item-info">
                                    <div class="summary-item-name"><%= item.name %></div>
                                    <% if (item.size) { %>
                                        <div class="summary-item-details">Size: <%= item.size %></div>
                                    <% } %>
                                    <div class="summary-item-details">Qty: <%= item.quantity %></div>
                                </div>
                                <div class="summary-item-price">Rs. <%= item.itemTotal.toLocaleString() %></div>
                            </div>
                        <% }); %>
                        
                        <div class="summary-row" style="margin-top: 20px; padding-top: 20px; border-top: 1px solid #F8F3EF;">
                            <span>Subtotal</span>
                            <span>Rs. <%= subtotal.toLocaleString() %></span>
                        </div>
                        
                        <div class="summary-row">
                            <span>Delivery</span>
                            <span>
                                <% if (deliveryCharge === 0) { %>
                                    <span style="color: #C9A45C; font-weight: 700;">FREE</span>
                                <% } else { %>
                                    Rs. <%= deliveryCharge.toLocaleString() %>
                                <% } %>
                            </span>
                        </div>
                        
                        <div class="summary-row total">
                            <span>Total</span>
                            <span class="price">Rs. <%= total.toLocaleString() %></span>
                        </div>
                        
                        <button type="submit" class="btn-place-order">
                            <i class="bi bi-lock me-2"></i>Place Order
                        </button>
                        
                        <a href="/cart" class="btn-back-cart">
                            <i class="bi bi-arrow-left me-2"></i>Back to Cart
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- Footer -->
<%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Handle form submission
        document.getElementById('checkoutForm').addEventListener('submit', function(e) {
            console.log('Form submitting...');
            
            // Validate fields
            const name = this.querySelector('[name="name"]').value.trim();
            const email = this.querySelector('[name="email"]').value.trim();
            const phone = this.querySelector('[name="phone"]').value.trim();
            const address = this.querySelector('[name="address"]').value.trim();
            const city = this.querySelector('[name="city"]').value.trim();
            const postalCode = this.querySelector('[name="postalCode"]').value.trim();
            
            if (!name || !email || !phone || !address || !city || !postalCode) {
                e.preventDefault();
                alert('Please fill in all required fields');
                return false;
            }
            
            console.log('Validation passed, submitting...');
            // Let form submit normally
        });
    </script>
</body>
</html>