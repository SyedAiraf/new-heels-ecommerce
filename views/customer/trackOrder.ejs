<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Track Your Order | New Heels</title>
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
<link rel="apple-touch-icon" href="/images/logo.jpg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <style>
        body { background: #F8F3EF; }
        
        .page-header {
            background: #F8F3EF;
            padding: 60px 0;
            text-align: center;
            margin-bottom: 40px;
            border-bottom: 1px solid #E8DFD5;
        }
        .page-header h1 {
            font-size: 36px;
            font-weight: 700;
            color: #3F3040;
            letter-spacing: 4px;
            text-transform: uppercase;
            margin-bottom: 12px;
        }
        .page-header p {
            color: #8B6688;
            font-size: 14px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        
        .track-card {
            background: white;
            padding: 45px 40px;
            border-top: 3px solid #C9A45C;
            box-shadow: 0 10px 40px rgba(63, 48, 64, 0.08);
            max-width: 900px;
            margin: 0 auto 40px;
        }
        
        .form-label {
            color: #3F3040;
            font-weight: 500;
            font-size: 11px;
            margin-bottom: 10px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        
        .form-control {
            border: 1px solid #E8DFD5;
            padding: 14px 18px;
            font-size: 14px;
            background: #F8F3EF;
            color: #3F3040;
            border-radius: 0;
        }
        
        .form-control:focus {
            border-color: #8B6688;
            background: white;
            box-shadow: 0 0 0 3px rgba(139, 102, 136, 0.08);
            outline: none;
        }
        
        .form-control::placeholder { color: #B9A0C0; }
        
        .btn-track {
            background: #8B6688;
            color: white;
            border: none;
            padding: 16px 40px;
            font-weight: 600;
            font-size: 12px;
            letter-spacing: 3px;
            text-transform: uppercase;
            transition: all 0.3s;
            cursor: pointer;
            width: 100%;
            margin-top: 25px;
        }
        
        .btn-track:hover {
            background: #3F3040;
            transform: translateY(-2px);
            box-shadow: 0 15px 30px rgba(63, 48, 64, 0.3);
        }
        
        .alert {
            padding: 15px 20px;
            font-size: 13px;
            margin-bottom: 25px;
            border: none;
        }
        
        .alert-danger {
            background: #F8F3EF;
            border-left: 4px solid #8B6688;
            color: #3F3040;
        }
        
        /* Order Info Box */
        .order-info-box {
            background: white;
            padding: 40px;
            border-top: 3px solid #C9A45C;
            box-shadow: 0 10px 40px rgba(63, 48, 64, 0.08);
            margin-bottom: 30px;
        }
        
        .order-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 25px;
            border-bottom: 2px solid #F8F3EF;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 15px;
        }
        
        .order-number-large {
            color: #3F3040;
            font-size: 24px;
            font-weight: 700;
            letter-spacing: 2px;
        }
        
        .order-number-large small {
            display: block;
            color: #8B6688;
            font-size: 11px;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-weight: 500;
            margin-bottom: 5px;
        }
        
        .status-badge-large {
            padding: 10px 25px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        
        .status-pending { background: #FFF3E0; color: #F57C00; border: 1px solid #F57C00; }
        .status-confirmed { background: #E8F3FF; color: #1976D2; border: 1px solid #1976D2; }
        .status-processing { background: #F3E5F5; color: #7B1FA2; border: 1px solid #7B1FA2; }
        .status-shipped { background: #E0F7FA; color: #0097A7; border: 1px solid #0097A7; }
        .status-delivered { background: #E8F5E9; color: #388E3C; border: 1px solid #388E3C; }
        .status-cancelled { background: #FCE4EC; color: #C2185B; border: 1px solid #C2185B; }
        
        /* Progress Timeline */
        .timeline {
            display: flex;
            justify-content: space-between;
            margin: 40px 0;
            position: relative;
            padding: 0 20px;
        }
        
        .timeline::before {
            content: '';
            position: absolute;
            top: 20px;
            left: 60px;
            right: 60px;
            height: 2px;
            background: #E8DFD5;
            z-index: 1;
        }
        
        .timeline-progress {
            position: absolute;
            top: 20px;
            left: 60px;
            height: 2px;
            background: #C9A45C;
            z-index: 2;
            transition: width 0.5s;
        }
        
        .timeline-step {
            position: relative;
            z-index: 3;
            text-align: center;
            flex: 1;
        }
        
        .timeline-dot {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: white;
            border: 2px solid #E8DFD5;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 12px;
            color: #B9A0C0;
            font-size: 16px;
            transition: all 0.3s;
        }
        
        .timeline-step.completed .timeline-dot {
            background: #C9A45C;
            border-color: #C9A45C;
            color: white;
        }
        
        .timeline-step.active .timeline-dot {
            background: #8B6688;
            border-color: #8B6688;
            color: white;
            transform: scale(1.1);
            box-shadow: 0 0 0 5px rgba(139, 102, 136, 0.15);
        }
        
        .timeline-step.cancelled .timeline-dot {
            background: #C2185B;
            border-color: #C2185B;
            color: white;
        }
        
        .timeline-label {
            color: #3F3040;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }
        
        .timeline-step.completed .timeline-label,
        .timeline-step.active .timeline-label {
            color: #8B6688;
        }
        
        /* Info Grid */
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin: 30px 0;
        }
        
        .info-box h5 {
            color: #3F3040;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid #F8F3EF;
        }
        
        .info-box p {
            color: #5a4a5c;
            font-size: 13px;
            line-height: 1.8;
            margin: 0;
        }
        
        .info-box p strong {
            color: #3F3040;
            display: block;
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-top: 10px;
            margin-bottom: 3px;
        }
        
        /* Items */
        .items-section h5 {
            color: #3F3040;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin: 30px 0 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #F8F3EF;
        }
        
        .order-item {
            display: flex;
            align-items: center;
            padding: 15px 0;
            border-bottom: 1px solid #F8F3EF;
        }
        
        .order-item:last-child { border-bottom: none; }
        
        .order-item img {
            width: 70px;
            height: 70px;
            object-fit: cover;
            background: #F8F3EF;
            margin-right: 15px;
            border: 1px solid #F8F3EF;
        }
        
        .order-item-info { flex: 1; }
        
        .order-item-name {
            color: #3F3040;
            font-weight: 500;
            font-size: 13px;
            margin-bottom: 4px;
        }
        
        .order-item-meta {
            color: #8B6688;
            font-size: 11px;
        }
        
        .order-item-price {
            color: #8B6688;
            font-weight: 700;
            font-size: 14px;
        }
        
        /* Totals */
        .totals-box {
            margin-top: 25px;
            padding-top: 20px;
            border-top: 2px solid #F8F3EF;
        }
        
        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            color: #8B6688;
            font-size: 13px;
        }
        
        .total-row.grand {
            font-size: 18px;
            font-weight: 700;
            color: #3F3040;
            padding-top: 15px;
            margin-top: 10px;
            border-top: 1px solid #F8F3EF;
        }
        
        .total-row.grand span:last-child {
            color: #8B6688;
        }
        
        .btn-continue {
            background: #8B6688;
            color: white;
            padding: 15px 40px;
            text-decoration: none;
            font-weight: 600;
            display: inline-block;
            transition: all 0.3s;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-size: 12px;
            border: none;
            cursor: pointer;
        }
        
        .btn-continue:hover {
            background: #3F3040;
            color: white;
            transform: translateY(-2px);
        }
        
        @media (max-width: 768px) {
            .page-header h1 { font-size: 24px; letter-spacing: 2px; }
            .track-card, .order-info-box { padding: 30px 20px; }
            .info-grid { grid-template-columns: 1fr; }
            .timeline-label { font-size: 9px; letter-spacing: 1px; }
            .timeline-dot { width: 32px; height: 32px; font-size: 14px; }
        }
    </style>
</head>
<body>
    <% if (session && session.adminId) { %>
        <a href="/admin/dashboard" style="position: fixed; bottom: 20px; left: 20px; background: #8B6688; color: white; padding: 12px 20px; text-decoration: none; font-weight: 500; z-index: 9999; display: flex; align-items: center; gap: 8px; font-size: 13px;">
            <i class="bi bi-speedometer2"></i> Back to Admin
        </a>
    <% } %>

    <!-- Header -->
    <div class="header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-4 col-md-3">
                    <a href="/" class="logo"><img src="/images/logo.jpg" alt="New Heels"></a>
                </div>
                <div class="col-md-6 d-none d-md-block">
                    <form class="search-bar mx-auto" action="/search" method="GET">
                        <input type="text" name="q" placeholder="Search for shoes, bags..." required>
                        <button type="submit"><i class="bi bi-search"></i></button>
                    </form>
                </div>
                <div class="col-8 col-md-3 text-end">
                    <div class="header-icons justify-content-end">
                        <a href="/cart" class="header-icon">
                            <i class="bi bi-cart"></i>
                            <span class="badge"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Navigation -->
    <div class="category-nav">
        <div class="container">
            <div class="d-flex justify-content-center flex-wrap">
                <a href="/">HOME</a>
                <a href="/category/men">MEN</a>
                <a href="/category/kids">KIDS</a>
                <a href="/category/female">WOMEN</a>
                <a href="/track-order">TRACK ORDER</a>
            </div>
        </div>
    </div>

    <!-- Page Header -->
    <div class="page-header">
        <div class="container">
            <h1>Track Your Order</h1>
            <p>Enter your order details to see the status</p>
        </div>
    </div>

    <div class="container mb-5">
        <!-- Track Form -->
        <div class="track-card">
            <% if (error) { %>
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-circle me-2"></i><%= error %>
                </div>
            <% } %>
            
            <form action="/track-order" method="POST">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Order Number</label>
                        <input type="text" class="form-control" name="orderNumber" placeholder="e.g., NH-12345678" required value="<%= order ? order.orderNumber : '' %>">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Phone Number</label>
                        <input type="tel" class="form-control" name="phone" placeholder="e.g., 03001234567" required>
                    </div>
                </div>
                <button type="submit" class="btn-track">
                    <i class="bi bi-search me-2"></i>Track Order
                </button>
            </form>
        </div>
        
        <!-- Order Result -->
        <% if (order) { %>
            <div class="order-info-box">
                <!-- Order Header -->
                <div class="order-header">
                    <div>
                        <div class="order-number-large">
                            <small>Order Number</small>
                            <%= order.orderNumber %>
                        </div>
                    </div>
                    <div>
                        <span class="status-badge-large status-<%= order.status %>">
                            <%= order.status %>
                        </span>
                    </div>
                </div>
                
                <!-- Timeline -->
                <% 
                    var statuses = ['pending', 'confirmed', 'processing', 'shipped', 'delivered'];
                    var currentIndex = statuses.indexOf(order.status);
                    var isCancelled = order.status === 'cancelled';
                %>
                
                <% if (!isCancelled) { %>
                <div class="timeline">
                    <% statuses.forEach(function(s, i) { %>
                        <div class="timeline-step <%= i < currentIndex ? 'completed' : (i === currentIndex ? 'active' : '') %>">
                            <div class="timeline-dot">
                                <% if (i < currentIndex) { %>
                                    <i class="bi bi-check"></i>
                                <% } else if (i === currentIndex) { %>
                                    <i class="bi bi-circle-fill" style="font-size: 8px;"></i>
                                <% } else { %>
                                    <i class="bi bi-circle" style="font-size: 10px;"></i>
                                <% } %>
                            </div>
                            <div class="timeline-label">
                                <%= s.charAt(0).toUpperCase() + s.slice(1) %>
                            </div>
                        </div>
                    <% }); %>
                </div>
                <% } else { %>
                <div class="alert alert-danger" style="margin-top: 30px;">
                    <i class="bi bi-x-circle me-2"></i>
                    This order has been cancelled. Please contact us for more information.
                </div>
                <% } %>
                
                <!-- Info Grid -->
                <div class="info-grid">
                    <div class="info-box">
                        <h5><i class="bi bi-person me-2"></i>Delivery Information</h5>
                        <p>
                            <strong>Customer Name</strong>
                            <%= order.customer.name %>
                            <strong>Phone</strong>
                            <%= order.customer.phone %>
                            <strong>Address</strong>
                            <%= order.customer.address %>, <%= order.customer.city %>, <%= order.customer.postalCode %>
                        </p>
                    </div>
                    <div class="info-box">
                        <h5><i class="bi bi-info-circle me-2"></i>Order Information</h5>
                        <p>
                            <strong>Order Date</strong>
                            <%= order.createdAt.toLocaleDateString('en-PK') %>
                            <strong>Payment Method</strong>
                            <%= order.paymentMethod === 'cod' ? 'Cash on Delivery' : 'Bank Transfer' %>
                            <strong>Payment Status</strong>
                            <%= order.paymentStatus.charAt(0).toUpperCase() + order.paymentStatus.slice(1) %>
                        </p>
                    </div>
                </div>
                
                <!-- Items -->
                <div class="items-section">
                    <h5><i class="bi bi-box-seam me-2"></i>Order Items</h5>
                    <% order.items.forEach(function(item) { %>
                        <div class="order-item">
                            <img src="<%= item.productImage || 'https://via.placeholder.com/70/F8F3EF/8B6688?text=P' %>" alt="<%= item.productName %>">
                            <div class="order-item-info">
                                <div class="order-item-name"><%= item.productName %></div>
                                <div class="order-item-meta">
                                    <% if (item.size) { %>Size: <%= item.size %> | <% } %>
                                    <% if (item.color) { %>Color: <%= item.color %> | <% } %>
                                    Qty: <%= item.quantity %>
                                </div>
                            </div>
                            <div class="order-item-price">Rs. <%= (item.price * item.quantity).toLocaleString() %></div>
                        </div>
                    <% }); %>
                </div>
                
                <!-- Totals -->
                <div class="totals-box">
                    <div class="total-row">
                        <span>Subtotal</span>
                        <span>Rs. <%= order.subtotal.toLocaleString() %></span>
                    </div>
                    <div class="total-row">
                        <span>Delivery</span>
                        <span><%= order.deliveryCharge === 0 ? 'FREE' : 'Rs. ' + order.deliveryCharge.toLocaleString() %></span>
                    </div>
                    <div class="total-row grand">
                        <span>Total</span>
                        <span>Rs. <%= order.total.toLocaleString() %></span>
                    </div>
                </div>
            </div>
            
            <div class="text-center">
                <a href="/" class="btn-continue">
                    <i class="bi bi-arrow-left me-2"></i>Continue Shopping
                </a>
            </div>
        <% } %>
    </div>

   <!-- Footer -->
<%- include('partials/footer') %>

    <a href="https://wa.me/923277985292" class="whatsapp-btn" target="_blank">
        <i class="bi bi-whatsapp"></i>
    </a>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>