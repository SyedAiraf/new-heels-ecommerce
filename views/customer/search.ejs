<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Results for "<%= query %>" | New Heels</title>
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
<link rel="apple-touch-icon" href="/images/logo.jpg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <style>
        /* ============ SEARCH PAGE SPECIFIC ============ */
        .page-header {
            background: #F8F3EF;
            padding: 60px 0;
            color: #3F3040;
            text-align: center;
            margin-bottom: 50px;
            border-bottom: 1px solid #E8DFD5;
        }

        .page-header h1 {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 12px;
            letter-spacing: 4px;
            text-transform: uppercase;
        }

        .page-header p {
            color: #8B6688;
            font-size: 14px;
            letter-spacing: 1.5px;
        }

        /* ============ PRODUCT CARDS ============ */
        .product-card {
            background: #FFFFFF;
            border: 1px solid #F8F3EF;
            overflow: hidden;
            transition: all 0.3s;
            margin-bottom: 25px;
            text-decoration: none;
            display: block;
            position: relative;
        }

        .product-card:hover {
            box-shadow: 0 20px 50px rgba(63, 48, 64, 0.12);
            transform: translateY(-5px);
        }

        .product-image-wrapper {
            position: relative;
            overflow: hidden;
            background: #F8F3EF;
            height: 320px;
            width: 100%;
        }

        .product-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: all 0.6s;
        }

        .product-card:hover .product-image {
            transform: scale(1.05);
        }

        .product-badge {
            position: absolute;
            top: 15px;
            left: 15px;
            background: #8B6688;
            color: white;
            padding: 5px 14px;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 2px;
            z-index: 2;
            text-transform: uppercase;
        }

        .discount-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            background: #C9A45C;
            color: white;
            padding: 5px 12px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            z-index: 2;
        }

        .sold-out-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(63, 48, 64, 0.75);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 16px;
            letter-spacing: 4px;
            z-index: 1;
            text-transform: uppercase;
        }

        .product-info {
            padding: 20px 15px;
            text-align: center;
        }

        .product-name {
            color: #3F3040;
            font-weight: 500;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .product-price {
            color: #8B6688;
            font-weight: 700;
            font-size: 17px;
        }

        .product-original-price {
            color: #B9A0C0;
            text-decoration: line-through;
            font-size: 13px;
            margin-left: 8px;
        }

        .empty-state {
            text-align: center;
            padding: 80px 20px;
        }

        .empty-state i {
            font-size: 70px;
            color: #C9A45C;
            margin-bottom: 25px;
        }

        .empty-state h3 {
            color: #3F3040;
            margin-bottom: 12px;
            letter-spacing: 3px;
            text-transform: uppercase;
            font-size: 22px;
        }

        .empty-state p {
            color: #8B6688;
            font-size: 15px;
            margin-bottom: 8px;
        }

        .empty-state ul {
            list-style: none;
            color: #8B6688;
            margin-top: 15px;
            padding: 0;
        }

        .empty-state ul li {
            margin-bottom: 8px;
            font-size: 14px;
        }

        @media (max-width: 768px) {
            .page-header h1 { font-size: 24px; letter-spacing: 3px; }
            .product-image-wrapper { height: 220px; }
            .product-name { font-size: 13px; }
            .product-price { font-size: 15px; }
        }
    </style>
</head>
<body>
    <% if (session && session.adminId) { %>
        <a href="/admin/dashboard" style="position: fixed; bottom: 20px; left: 20px; background: #8B6688; color: white; padding: 12px 20px; text-decoration: none; font-weight: 500; box-shadow: 0 10px 30px rgba(139, 102, 136, 0.4); z-index: 9999; display: flex; align-items: center; gap: 8px; letter-spacing: 1px; font-size: 13px;">
            <i class="bi bi-speedometer2"></i> Back to Admin
        </a>
    <% } %>

    <!-- Header -->
    <div class="header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-4 col-md-3">
                    <a href="/" class="logo"><img src="/images/logo.jpg" alt="New Heels"></a>
                </div>
                <div class="col-md-6 d-none d-md-block">
                    <form class="search-bar mx-auto" action="/search" method="GET">
                        <input type="text" name="q" placeholder="Search for shoes, bags..." value="<%= query %>" required>
                        <button type="submit"><i class="bi bi-search"></i></button>
                    </form>
                </div>
                <div class="col-8 col-md-3 text-end">
                    <div class="header-icons justify-content-end">
                        <a href="#" class="header-icon"><i class="bi bi-heart"></i></a>
                        <a href="/cart" class="header-icon">
                            <i class="bi bi-cart"></i>
                            <span class="badge"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Navigation -->
    <div class="category-nav">
        <div class="container">
            <div class="d-flex justify-content-center flex-wrap">
                <a href="/">HOME</a>
                <a href="/category/men">MEN</a>
                <a href="/category/kids">KIDS</a>
                <a href="/category/female">WOMEN</a>
                <a href="/category/female?sub=shoes-sandals">SALE</a>
                <a href="/category/female?sub=bags-purses">NEW ARRIVALS</a>
            </div>
        </div>
    </div>

    <!-- Page Header -->
    <div class="page-header">
        <div class="container">
            <h1>Search Results</h1>
            <p>
                <% if (products.length > 0) { %>
                    Found <%= products.length %> product<%= products.length !== 1 ? 's' : '' %> for "<%= query %>"
                <% } else { %>
                    No results for "<%= query %>"
                <% } %>
            </p>
        </div>
    </div>

    <!-- Products -->
    <div class="container mb-5">
        <% if (products.length > 0) { %>
            <div class="row">
                <% products.forEach(function(product) { %>
                    <% var totalStock = 0; %>
                    <% if (product.variations && product.variations.length > 0) { %>
                        <% product.variations.forEach(function(v) { totalStock += v.stock; }); %>
                    <% } else { %>
                        <% totalStock = product.stock; %>
                    <% } %>
                    
                    <div class="col-6 col-md-3">
                        <a href="/product/<%= product.slug %>" class="product-card">
                            <div class="product-image-wrapper">
                                <% if (product.salePrice) { %>
                                    <span class="product-badge sale">SALE</span>
                                    <span class="discount-badge">-<%= Math.round(((product.price - product.salePrice) / product.price) * 100) %>%</span>
                                <% } %>
                                <% if (product.images && product.images.length > 0) { %>
                                    <img src="<%= product.images[0] %>" class="product-image" alt="<%= product.name %>">
                                <% } else { %>
                                    <div class="product-image d-flex align-items-center justify-content-center">
                                        <i class="bi bi-image" style="font-size: 40px; color: #C9A45C;"></i>
                                    </div>
                                <% } %>
                                <% if (totalStock === 0) { %>
                                    <div class="sold-out-overlay">SOLD OUT</div>
                                <% } %>
                            </div>
                            <div class="product-info">
                                <div class="product-name"><%= product.name %></div>
                                <% if (product.salePrice) { %>
                                    <span class="product-price">Rs. <%= product.salePrice.toLocaleString() %></span>
                                    <span class="product-original-price">Rs. <%= product.price.toLocaleString() %></span>
                                <% } else { %>
                                    <span class="product-price">Rs. <%= product.price.toLocaleString() %></span>
                                <% } %>
                            </div>
                        </a>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <i class="bi bi-search"></i>
                <h3>No Results Found</h3>
                <p>We couldn't find any products for "<%= query %>"</p>
                <ul>
                    <li>• Check your spelling</li>
                    <li>• Use more general terms (e.g., "shoes" instead of "red leather shoes")</li>
                    <li>• Browse our <a href="/category/female" style="color: #8B6688; text-decoration: underline;">categories</a></li>
                </ul>
            </div>
        <% } %>
    </div>

    <!-- Footer -->
<%- include('partials/footer') %>

    <!-- WhatsApp Button -->
    <a href="https://wa.me/923277985292?text=Hello%20New%20Heels" class="whatsapp-btn" target="_blank">
        <i class="bi bi-whatsapp"></i>
    </a>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>