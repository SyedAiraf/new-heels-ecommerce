<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Confirmed - Thank You! | New Heels</title>
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg">
<link rel="apple-touch-icon" href="/images/logo.jpg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <style>
        body { background: #F8F3EF; }
        
        .success-section {
            padding: 60px 0;
            min-height: 70vh;
            display: flex;
            align-items: center;
        }
        
        .success-card {
            background: white;
            padding: 60px 45px;
            text-align: center;
            max-width: 700px;
            margin: 0 auto;
            border-top: 4px solid #C9A45C;
            box-shadow: 0 10px 40px rgba(63, 48, 64, 0.08);
        }
        
        .success-icon {
            width: 100px;
            height: 100px;
            background: #8B6688;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 30px;
            animation: scaleIn 0.5s ease-out;
        }
        
        .success-icon i {
            font-size: 50px;
            color: white;
        }
        
        @keyframes scaleIn {
            from { transform: scale(0); }
            to { transform: scale(1); }
        }
        
        .success-title {
            color: #3F3040;
            font-weight: 700;
            font-size: 32px;
            margin-bottom: 12px;
            letter-spacing: 3px;
            text-transform: uppercase;
        }
        
        .success-subtitle {
            color: #8B6688;
            font-size: 14px;
            margin-bottom: 35px;
            letter-spacing: 1px;
        }
        
        .order-number {
            background: #F8F3EF;
            border: 2px dashed #C9A45C;
            padding: 20px;
            display: inline-block;
            margin-bottom: 35px;
            min-width: 280px;
        }
        
        .order-number small {
            color: #8B6688;
            font-size: 11px;
            display: block;
            margin-bottom: 6px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        
        .order-number strong {
            color: #8B6688;
            font-size: 22px;
            letter-spacing: 2px;
        }
        
        .order-details {
            background: #F8F3EF;
            padding: 30px;
            margin: 35px 0;
            text-align: left;
        }
        
        .order-details h5 {
            color: #3F3040;
            font-weight: 600;
            margin-bottom: 20px;
            font-size: 14px;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding-bottom: 12px;
            border-bottom: 1px solid #E8DFD5;
        }
        
        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid #E8DFD5;
            font-size: 13px;
        }
        
        .detail-row:last-child {
            border-bottom: none;
        }
        
        .detail-row strong {
            color: #3F3040;
            font-weight: 500;
            letter-spacing: 0.5px;
        }
        
        .detail-row span {
            color: #5a4a5c;
        }
        
        .status-badge {
            background: #C9A45C;
            color: white;
            padding: 5px 14px;
            font-size: 11px;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-weight: 600;
        }
        
        .btn-continue-shopping {
            background: #8B6688;
            color: white;
            padding: 15px 40px;
            text-decoration: none;
            font-weight: 600;
            display: inline-block;
            transition: all 0.3s;
            letter-spacing: 3px;
            text-transform: uppercase;
            font-size: 12px;
        }
        
        .btn-continue-shopping:hover {
            background: #3F3040;
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(63, 48, 64, 0.3);
            color: white;
        }
        
        .info-note {
            color: #8B6688;
            font-size: 13px;
            margin-bottom: 30px;
            letter-spacing: 0.5px;
        }
    </style>
</head>
<body>
    <!-- Header -->
    <div class="header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-6">
                    <a href="/" class="logo"><img src="/images/logo.jpg" alt="New Heels" style="height: 70px;"></a>
                </div>
                <div class="col-6 text-end">
                    <a href="/cart" class="header-icon">
                        <i class="bi bi-cart" style="font-size: 22px; color: #3F3040;"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Section -->
    <section class="success-section">
        <div class="container">
            <div class="success-card">
                <div class="success-icon">
                    <i class="bi bi-check-lg"></i>
                </div>
                
                <h1 class="success-title">Order Confirmed!</h1>
                <p class="success-subtitle">Thank you for your order. We'll contact you soon.</p>
                
                <div class="order-number">
                    <small>Order Number</small>
                    <strong><%= order.orderNumber %></strong>
                </div>
                
                <div class="order-details">
                    <h5><i class="bi bi-receipt me-2"></i>Order Details</h5>
                    
                    <div class="detail-row">
                        <strong>Customer Name</strong>
                        <span><%= order.customer.name %></span>
                    </div>
                    <div class="detail-row">
                        <strong>Phone</strong>
                        <span><%= order.customer.phone %></span>
                    </div>
                    <div class="detail-row">
                        <strong>Delivery Address</strong>
                        <span><%= order.customer.address %>, <%= order.customer.city %></span>
                    </div>
                    <div class="detail-row">
                        <strong>Payment Method</strong>
                        <span>
                            <% if (order.paymentMethod === 'cod') { %>
                                Cash on Delivery
                            <% } else { %>
                                Bank Transfer
                            <% } %>
                        </span>
                    </div>
                    <div class="detail-row">
                        <strong>Total Amount</strong>
                        <span style="color: #8B6688; font-weight: 700; font-size: 16px;">
                            Rs. <%= order.total.toLocaleString() %>
                        </span>
                    </div>
                    <div class="detail-row">
                        <strong>Status</strong>
                        <span class="status-badge">PENDING</span>
                    </div>
                </div>
                
                <p class="info-note">
                    <i class="bi bi-info-circle me-2"></i>
                    We'll call you within 24 hours to confirm your order.
                </p>
                
                <a href="/" class="btn-continue-shopping">
                    <i class="bi bi-bag me-2"></i>Continue Shopping
                </a>
            </div>
        </div>
    </section>

  <!-- Footer -->
<%- include('partials/footer') %>
    <!-- WhatsApp Button -->
    <a href="https://wa.me/923277985292?text=Hello%20New%20Heels" class="whatsapp-btn" target="_blank">
        <i class="bi bi-whatsapp"></i>
    </a>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>